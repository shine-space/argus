:where(.fc){position:relative;z-index:10} .fc,.fc *{box-sizing:border-box;min-width:0} .fc-sr{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip:rect(0 0 0 0)!important;white-space:nowrap!important;padding:0!important;margin:-1px!important;border:0!important} :where(.fc) a{color:inherit} html,body{overflow-x:clip}
:where(a[href],button,input,select,textarea,summary,[tabindex]:not([tabindex="-1"]),[role="button"]):focus-visible{outline:3px solid var(--fc-ink,#1D1830)!important;outline-offset:2px!important;box-shadow:0 0 0 2px var(--fc-bone,#EDE3D1)!important} :where(.fc-dark) :where(a[href],button,input,select,textarea,summary,[tabindex]:not([tabindex="-1"])):focus-visible{outline-color:var(--fc-cloud,#FFFFFF)!important;box-shadow:0 0 0 2px var(--fc-night,#0F1113)!important} :where(.fc-inring) :where(a[href],button):focus-visible{outline-offset:-4px!important;box-shadow:none!important} :where(.fc) :is(input:not([type=range]):not([type=checkbox]):not([type=radio]),textarea,select):focus-visible{outline:none!important;box-shadow:none!important} :where(.fc) textarea{resize:none} .fc-inring:focus-visible{outline-offset:-3px!important;box-shadow:none!important} html{scroll-padding-top:96px;scroll-padding-bottom:88px}
.fc-btn{position:relative;display:inline-flex;padding:0;min-height:54px;border-radius:999px;text-decoration:none;cursor:pointer;isolation:isolate;white-space:nowrap;font-size:14.5px;font-weight:600;letter-spacing:.005em;border:0;color:var(--fg);transition:transform .5s cubic-bezier(.2,.8,.2,1)}
.fc-cap{position:relative;display:inline-flex;align-items:center;gap:14px;width:100%;min-height:inherit;padding:0 7px 0 24px;border-radius:inherit;background:var(--face);overflow:hidden;box-shadow:inset 0 0 0 1.5px var(--edge);isolation:isolate}
.fc-cap::before{content:"";position:absolute;z-index:-1;inset:0;border-radius:inherit;background:var(--fill);clip-path:inset(0 100% 0 0 round 999px);transition:clip-path .55s cubic-bezier(.7,0,.2,1)}
.fc-btn:hover .fc-cap::before,.fc-btn:focus-visible .fc-cap::before{clip-path:inset(0 0 0 0 round 999px)}
.fc-btn:hover,.fc-btn:focus-visible{color:var(--fg2)}
.fc-btn.fc-noarr .fc-cap{padding-right:24px}
.fc-port{position:relative;width:9px;height:9px;flex:none;border-radius:50%;background:transparent;box-shadow:inset 0 0 0 2px currentColor;transition:background .3s,box-shadow .3s}
.fc-btn:hover .fc-port,.fc-btn:focus-visible .fc-port{background:var(--led);box-shadow:inset 0 0 0 2px var(--led),0 0 0 4px color-mix(in srgb,var(--led) 28%,transparent)}
.fc-arr{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;flex:none;background:var(--chip);color:var(--chipfg);transition:translate .5s cubic-bezier(.34,1.56,.64,1),rotate .5s cubic-bezier(.34,1.56,.64,1),background .3s,color .3s} .fc-btn:hover .fc-arr{rotate:-45deg}
.fc-lbl{position:relative;display:inline-block;height:1.2em;overflow:hidden;line-height:1.2} .fc-l1,.fc-l2{display:block;transition:translate .45s cubic-bezier(.7,0,.2,1)} .fc-btn:hover .fc-l1,.fc-btn:hover .fc-l2{translate:0 -100%}
.fc-btn.fc-solid{--face:var(--fc-ink);--edge:var(--fc-ink);--fill:var(--fc-brass);--fg:var(--fc-cloud);--fg2:var(--fc-ink);--led:var(--fc-ink);--chip:var(--fc-brass);--chipfg:var(--fc-ink)}
.fc-btn.fc-solid:hover{--chip:var(--fc-ink);--chipfg:var(--fc-brass)}
.fc-btn.fc-ghost{--face:transparent;--edge:color-mix(in srgb,var(--fc-ink) 22%,transparent);--fill:var(--fc-cloud);--fg:var(--fc-ink);--fg2:var(--fc-ink);--led:var(--fc-brass);--chip:var(--fc-ink);--chipfg:var(--fc-cloud)}
.fc-btn.fc-quiet{--face:color-mix(in srgb,var(--fc-cloud) 12%,transparent);--edge:color-mix(in srgb,var(--fc-cloud) 22%,transparent);--fill:var(--fc-brass);--fg:var(--fc-cloud);--fg2:var(--fc-ink);--led:var(--fc-ink);--chip:var(--fc-brass);--chipfg:var(--fc-ink)}
@media (max-width:600px),(hover:none){.fc .fc-btn{white-space:normal;text-align:left;line-height:1.25;min-height:52px;max-width:100%} .fc .fc-lbl{height:auto} .fc .fc-l2{display:none}}
.fc-btn:hover{transform:translate(var(--mx,0px),var(--my,0px))} .fc-btn:active{transform:translate(var(--mx,0px),var(--my,0px)) scale(.97)!important}
.fc-dark .fc-btn.fc-ghost{--face:color-mix(in srgb,var(--fc-cloud) 12%,transparent);--edge:color-mix(in srgb,var(--fc-cloud) 30%,transparent);--fill:var(--fc-cloud);--fg:var(--fc-cloud);--fg2:var(--fc-ink);--chip:var(--fc-cloud);--chipfg:var(--fc-ink)} .fc-dark .fc-btn.fc-ghost .fc-cap{-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
.fc-dark .fc-btn.fc-solid{--face:var(--fc-cloud);--edge:var(--fc-cloud);--fill:var(--fc-brass);--fg:var(--fc-ink);--fg2:var(--fc-ink);--chip:var(--fc-ink);--chipfg:var(--fc-cloud)}
/* TEXT-SAFE accents: mint is a FILL (ink text on it), a wire or a port; small mint TEXT on light grounds uses the darker --fc-acc. On dark grounds the mint itself reads. */
.fc{--fc-acc:color-mix(in srgb,var(--fc-brass) 40%,var(--fc-ink));--fc-acc-lg:color-mix(in srgb,var(--fc-brass) 62%,var(--fc-ink));--fc-mut:color-mix(in srgb,var(--fc-stone) 85%,var(--fc-ink));--fc-acc-d:var(--fc-brass)}
.fc-lt,.fc .fc-lt{--fc-acc:color-mix(in srgb,var(--fc-brass) 40%,var(--fc-ink));--fc-acc-lg:color-mix(in srgb,var(--fc-brass) 62%,var(--fc-ink));--fc-mut:color-mix(in srgb,var(--fc-stone) 85%,var(--fc-ink))}
.fc-dark,.fc.fc-dark{--fc-acc:var(--fc-brass);--fc-acc-lg:var(--fc-brass);--fc-mut:color-mix(in srgb,var(--fc-stone) 45%,var(--fc-cloud))}
/* LED segment strip (status rows) */
.fc-bar{width:26px;height:10px;flex:none;display:inline-block;background:repeating-linear-gradient(90deg,currentColor 0 1px,transparent 1px 3px,currentColor 3px 5px,transparent 5px 6px,currentColor 6px 7px,transparent 7px 9px,currentColor 9px 10px,transparent 10px 12px)}
@media (prefers-reduced-motion:reduce){.fc *,.sth *{animation-duration:.01ms!important;transition-duration:.01ms!important}}
.fccs-next:focus-visible,.fcpo-next:focus-visible,.fcw-row a:focus-visible,.fco-band:focus-visible,.fco-mq a:focus-visible{outline-offset:-4px!important;box-shadow:none!important}`,N.Boolean,N.Number,Le=e=>String(e||``).split(/\s+/).filter(Boolean).map(e=>{let t=e.match(/^\*(.+?)\*([.,!?;:’']*)$/);return t?{t:t[1],tail:t[2],acc:!0}:{t:e.replace(/\*/g,``),tail:``,acc:!1}}),Re=e=>String(e||``).replace(/\*/g,``).replace(/\s*\|\s*/g,` `).replace(/\s+/g,` `).trim(),ze=({text:e,on:t,D:n,tag:r=`h2`,size:i=`clamp(38px,4.3vw,64px)`,lh:a=1.02,delay:o=0,step:s=55,style:l,className:f})=>{let p=r,m=0;return d(p,{className:`fc-hd${t?` is-on`:``}${f?` `+f:``}`,"aria-label":Re(e),style:{...n,fontSize:typeof i==`number`?Math.max(12,i):i,lineHeight:a,...l||{}},children:String(e).split(`|`).map((e,t)=>d(`span`,{className:`fc-hd-l`,"aria-hidden":!0,children:Le(e).map((e,t)=>{let n=o+m++*s;return u(`span`,{className:`fc-hd-w${e.acc?` is-accw`:``}`,children:[d(`span`,{className:`fc-hd-i${e.acc?` is-acc`:``}`,style:{transitionDelay:`${n}ms`,"--pd":`${n+500}ms`},children:e.acc?u(`span`,{className:`fc-it`,children:[e.t,e.tail,d(`svg`,{className:`fc-spark`,viewBox:`0 0 24 24`,"aria-hidden":!0,children:d(`path`,{d:`M12 1.5C12.9 8 16 11.1 22.5 12 16 12.9 12.9 16 12 22.5 11.1 16 8 12.9 1.5 12 8 11.1 11.1 8 12 1.5Z`})})]}):u(c,{children:[e.t,e.tail]})}),` `]},t)})},t))})},K=(e,t=0,n=22)=>({opacity:+!!e,translate:e?`0 0`:`0 ${n}px`,transition:`opacity .9s ease ${t}ms, translate 1s cubic-bezier(.2,.8,.2,1) ${t}ms`}),Be=__sharedLayoutCss(we),q={site:[{slug:`site`,f1:`argus`,f2:"AI 自动化工作室",f3:"为团队打造日常使用的 AI 智能体与自动化流程，覆盖客服、销售运营和后台事务，数周即可上线。",f4:`hello@argus.ai`,f5:`+1 646 555 0187`,f6:"纽约",f7:`America/New_York`,f8:`/book`,f9:`X:https://x.com, LinkedIn:https://linkedin.com, YouTube:https://youtube.com`,f10:"第四季度项目预约中 · 剩余 3 个名额",f11:"美国纽约市西 21 街 54 号，邮编 10010",f12:"周一至周五 09:00–18:00（美国东部时间）",f13:`1-5 09:00-18:00`,n1:`1`}],services:[{slug:`voice-agents`,f1:"语音智能体",f2:"日夜在线的 AI 接待员，以自然语音接听每一通来电、安排预约并筛选意向客户。",f3:`0 missed`,f4:"非工作时间来电",f5:`voice`,f6:`Twilio, Vapi, Google Calendar, HubSpot`,f7:"围绕你的价格、政策和日历配置。来电者提出要求时，立即转交人工。",f8:"听取 50 通真实来电，梳理来电者的问题;制定语音风格、规则和人工接管条件;连接日历、CRM 和电话线路;与你的团队并行试运行一周",f9:"符合品牌风格的自然语音;预约、改约与确认;解答价格、营业时间和政策问题;按需转接人工;通话录音与摘要同步到 CRM",f10:`$8,500`,n1:`1`},{slug:`workflow-automation`,f1:"工作流自动化",f2:"工具之间的复制粘贴交给智能体：发票入账、CRM 更新、报告发送，自动完成。",f3:`31 h`,f4:"每人每月节省时间",f5:`workflow`,f6:`Make, n8n, Zapier, Xero, Slack`,f7:"先梳理流程，再自动化其中的重复步骤，需要判断的环节继续由人工负责。",f8:"跟进实际流程，记录每一步耗时;确定智能体负责什么、哪些环节由人工审批;构建工作流，加入日志与告警;提供操作手册与培训，完成交付",f9:"读取邮件、PDF 与表单;在你的工具之间流转数据;需要判断的环节由人工审批;出现异常时通过 Slack 告警;每月节省工时报告",f10:`$6,500`,n1:`2`},{slug:`support-agents`,f1:"客服智能体",f2:"根据文档和订单数据回答问题，能直接解决问题的聊天与邮件客服智能体。",f3:`68%`,f4:"无需人工解决的工单",f5:`support`,f6:`Zendesk, Intercom, Shopify, Gorgias`,f7:"每个回答都引用来源页面。不确定的问题会附上回复草稿交给你的团队。",f8:"阅读 500 张历史工单，按意图分类;连接客服系统、店铺和文档;编写答案与升级人工规则;先上线一个渠道，再逐步扩展",f9:"接入客服系统的聊天和邮件渠道;订单查询、退货与物流追踪;根据你的文档回答并引用来源;升级人工时附上回复草稿;每周准确率复盘",f10:`$9,500`,n1:`3`},{slug:`knowledge-base`,f1:"AI 知识库",f2:"一个搜索框，覆盖云盘、知识库和邮箱，用通俗语言回答，并附带来源。",f3:`9 s`,f4:"找到答案",f5:`knowledge`,f6:`Notion, Google Drive, Confluence, Slack`,f7:"公司专属，遵循现有访问权限，并随文件变化自动更新。",f8:"列出数据来源和访问权限;按权限索引云盘、知识库与邮箱;用 100 个真实问题测试答案;在 Slack 或 Teams 中发布",f9:"检索云盘、知识库与邮件;回答附带来源及页码;遵循现有访问权限;随文件变化保持同步;使用情况与知识缺口报告",f10:`$7,500`,n1:`4`},{slug:`custom-ai-apps`,f1:"定制 AI 应用",f2:"围绕模型打造内部工具：提案撰写、报价生成、线索评分。",f3:`4 wks`,f4:"从想法到工具上线",f5:`apps`,f6:`OpenAI, Anthropic, Supabase, Retool`,f7:"精巧实用的工具，让团队每天都愿意打开，并配备运营负责人所需的约束机制和日志。",f8:"找出最值得开发工具的那项任务;一周内与你的团队完成原型;开发时配置约束机制与日志;上线、培训并衡量成效",f9:"专注解决问题的内部工具;根据任务选用最合适的模型;访问控制与审计日志;由我们托管和维护;每月持续迭代",f10:`$12,000`,n1:`5`}],work:[{slug:`northwind-dental`,f1:`Northwind Dental`,f2:"医疗健康",f3:"让预约量提升 38% 的语音智能体",f4:`+38%`,f5:"预约量",f6:"六家诊所共用一条永不漏接的电话线。智能体直接在诊所管理软件中预约、改约和确认就诊。",f7:"语音智能体",img:`https://framerusercontent.com/images/OPO7hpxO5fFgicqBiebGwosE.webp`,f8:"六家诊所共用一条电话线。下午五点后和午休时，三分之一的来电无人接听，每一通漏接都意味着一次流失的预约。",f9:"语音智能体使用诊所的沟通风格，在诊所管理软件中预约、改约和确认就诊；涉及医疗判断的问题一律转交护士。",f10:"+38%|预约量;0|非工作时间漏接来电;4.8/5|来电者评分;11 h|每周为前台节省的时间",f11:"患者听不出这是智能体，前台终于有时间照顾现场的人了。",f12:"Dr. Sarah Kim, 医疗总监",f13:`4 weeks`,f14:`Vapi, Twilio, Dentrix, HubSpot`,n1:`1`},{slug:`ledgerly`,f1:`Ledgerly`,f2:"财会",f3:"月末结账从 9 天缩短至 2 天",f4:`2 days`,f5:"月末结账",f6:"由智能体核对发票、收据和银行流水，异常情况由人工审批。",f7:"工作流自动化",img:`https://framerusercontent.com/images/xC399cfk7wneLE2CiZd0LCKY70.webp`,f8:"月末结账耗时九天：需要在三个工具之间，手工核对 2,000 张发票、收据和银行流水。",f9:"发票智能体读取每份单据，与采购订单和银行流水核对，在 Xero 中入账，仅将异常情况交给人工处理。",f10:"2 天|月末结账;1,900|每周发票量;97%|无需人工匹配;9 h|每周节省时间",f11:"他们找出了我们每周浪费的九个小时，并将这些工作自动化。",f12:"Marcus Webb, 财务负责人",f13:`5 weeks`,f14:`n8n, Xero, Google Drive, Slack`,n1:`2`},{slug:`oakline-home`,f1:`Oakline Home`,f2:"电子商务",f3:"每 10 张客服工单中有 7 张由 AI 解决",f4:`71%`,f5:"工单由 AI 解决",f6:"根据 Shopify 数据，数秒内回答订单、退货与配送变更问题。",f7:"客服智能体",img:`https://framerusercontent.com/images/A1LSpWqZartLRT6sPWVxN0Ijbo.webp`,f8:"订单、退货和配送变更咨询挤满客服系统，高峰时段需要六小时才能回复。",f9:"通过聊天和邮件提供服务的客服智能体，根据 Shopify 数据和配送政策回答问题、处理退货，并在升级人工时附上回复草稿。",f10:"71%|工单由 AI 解决;38 s|首次回复;+9 分|CSAT;3x|每人处理工单量",f11:"71% 的工单无需人工处理，客户满意度也提升了。",f12:"Priya Nair, 客户体验负责人",f13:`4 weeks`,f14:`Gorgias, Shopify, OpenAI, Slack`,n1:`3`},{slug:`vantage-legal`,f1:`Vantage Legal`,f2:"法律服务",f3:"数秒找到每一份判例",f4:`9 s`,f5:"平均搜索用时",f6:"覆盖 14 年案件资料的私有知识库，遵循访问权限，回答附带来源。",f7:"AI 知识库",img:`https://framerusercontent.com/images/hPOHK0EMfYfzD6Gkwr40RfxeeRk.webp`,f8:"14 年的案件资料分散在文件夹中，只有合伙人才知道如何检索。",f9:"遵循访问权限的私有知识库，用通俗语言回答，并引用具体文档和页码。",f10:"9 s|平均搜索用时;14 年|年案件资料已索引;100%|回答附带来源;6 h|每位律师每周节省时间",f11:"这是我们的律师每天早上最先打开的工具。",f12:"Helen Park, 管理合伙人",f13:`6 weeks`,f14:`Anthropic, Pinecone, SharePoint, Teams`,n1:`4`},{slug:`brightpath-realty`,f1:`Brightpath Realty`,f2:"房地产",f3:"全天候响应，40 秒回复客户线索",f4:`40 s`,f5:"客户线索首次回复用时",f6:"每一条房产平台咨询，都会在经纪人查看前得到回复、看房时段及一条 CRM 记录。",f7:"工作流自动化",img:`https://framerusercontent.com/images/t7VGq6b8rzt8deI2pJExlQ61qzM.webp`,f8:"房产平台的咨询要等数小时才得到回复，那时买家早已联系了另外三位经纪人。",f9:"线索智能体在一分钟内回复，识别买家需求、提供看房时段，并在人工查看前写入 CRM。",f10:"40 s|首次回复;+27%|看房预约量;100%|线索已录入 CRM;24/7|覆盖时段",f11:"高效、细致，并坦诚说明 AI 的能力边界。",f12:"Daniel Ortiz，首席运营官",f13:`3 weeks`,f14:`Make, HubSpot, Google Calendar, WhatsApp`,n1:`5`}]},Ve=`FcService@cms1`,He=(e,t=`img`)=>String(e&&e[t]||``).split(`?`)[0],Ue=`data:image/svg+xml;utf8,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%20400%20500'%20preserveAspectRatio%3D'xMidYMid%20slice'%3E%3Crect%20width%3D'400'%20height%3D'500'%20fill%3D'%23D3D8E2'%2F%3E%3Crect%20x%3D'120'%20y%3D'170'%20width%3D'160'%20height%3D'160'%20rx%3D'8'%20fill%3D'none'%20stroke%3D'%23AEB6C6'%20stroke-width%3D'1.5'%2F%3E%3Crect%20x%3D'100'%20y%3D'150'%20width%3D'200'%20height%3D'200'%20rx%3D'10'%20fill%3D'none'%20stroke%3D'%23C3CAD8'%20stroke-width%3D'1'%20stroke-dasharray%3D'2%206'%2F%3E%3C%2Fsvg%3E`,We=(e,t=`img`)=>He(e,t)||Ue,Ge=a===void 0?h:r,J=e=>String(e||``).split(`;`).map(e=>e.trim()).filter(Boolean),Y=`
.fcsv{position:relative;background:var(--fc-bone);color:var(--fc-ink)}
.fcsv-top{position:relative;background:var(--fc-night);color:var(--fc-cloud);padding:clamp(150px,18vh,200px) 0 clamp(70px,8vw,120px);overflow:hidden}
.fcsv-top::before{content:"";position:absolute;right:-10%;top:-20%;width:70vw;aspect-ratio:1/1;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--fc-brass) 14%,transparent),color-mix(in srgb,var(--fc-brass) 0.4%,transparent) 60%);pointer-events:none}
.fcsv-tg{position:relative;display:grid;grid-template-columns:1.05fr 1fr;gap:clamp(30px,5vw,80px);align-items:center}
.fcsv-cr ol{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:0 0 26px;padding:0;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)} .fcsv-cr li+li::before{content:"/";margin-right:8px;opacity:.5} .fcsv-cr a{color:inherit;text-decoration:none} .fcsv-cr [aria-current]{color:var(--fc-cloud)}
.fcsv-short{margin:26px 0 0;max-width:540px;font-size:clamp(17px,1.35vw,21px);line-height:1.5;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
.fcsv-meta{display:flex;gap:40px;margin-top:30px;padding-top:24px;border-top:1px solid color-mix(in srgb,var(--fc-cloud) 12%,transparent)} .fcsv-meta span{display:flex;flex-direction:column;gap:4px} .fcsv-meta b{font-size:clamp(36px,3.2vw,56px);font-weight:500;letter-spacing:-.05em;line-height:1} .fcsv-meta em{font-style:normal;font-size:12.5px;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
.fcsv-cta{margin-top:30px} .fcsv .fc-btn.fc-solid{--face:var(--fc-brass);--edge:var(--fc-brass);--fill:var(--fc-cloud);--fg:var(--fc-ink);--fg2:var(--fc-ink);--chip:var(--fc-ink);--chipfg:var(--fc-brass)}
.fcsv-demo{display:flex;align-items:center;justify-content:center;min-height:clamp(420px,38vw,560px);padding:clamp(22px,2.6vw,40px);border-radius:34px;background:color-mix(in srgb,var(--fc-pine) 80%,var(--fc-night));box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-brass) 26%,transparent),0 60px 100px -50px #000;transition:opacity 1s ease .3s}
.fcsv-body{padding:clamp(80px,9vw,140px) 0}
.fcsv-det{margin:0 0 clamp(60px,7vw,110px);max-width:1100px;font-size:clamp(28px,3vw,52px);font-weight:500;letter-spacing:-.04em;line-height:1.12}
.fcsv-h{margin:0 0 28px;font-size:clamp(28px,2.4vw,40px);font-weight:500;letter-spacing:-.04em}
.fcsv-track{position:relative;margin-bottom:clamp(70px,8vw,120px);--tf:0} .fcsv-track ol{position:relative;list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:22px}
.fcsv-line{position:absolute;left:0;right:0;top:27px;height:2px;background:var(--fc-fog)} .fcsv-line i{position:absolute;inset:0;background:var(--fc-brass);transform-origin:0 50%;transform:scaleX(var(--tf))}
.fcsv-track li{position:relative;display:flex;flex-direction:column;gap:18px;opacity:0;translate:0 20px;transition:opacity .7s ease calc(var(--i)*.12s),translate .8s cubic-bezier(.2,.8,.2,1) calc(var(--i)*.12s)} .fcsv-track.is-on li{opacity:1;translate:0 0}
.fcsv-dot{display:grid;place-items:center;width:56px;height:56px;border-radius:50%;background:var(--fc-ink);color:var(--fc-brass);font-size:13px;box-shadow:0 0 0 8px var(--fc-bone)} .fcsv-track li p{margin:0;font-size:16px;line-height:1.5;max-width:280px}
.fcsv-two{display:grid;grid-template-columns:1fr 1fr;gap:clamp(30px,5vw,80px);align-items:start}
.fcsv-inc{list-style:none;margin:0;padding:0;display:flex;flex-direction:column} .fcsv-inc li{display:flex;align-items:center;gap:14px;padding:16px 0;border-bottom:1px solid var(--fc-fog);font-size:17px} .fcsv-inc i{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;flex:none;background:var(--fc-brass);color:var(--fc-ink)}
.fcsv-tools{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:30px} .fcsv-tools span{padding:10px 15px;border-radius:999px;background:var(--fc-cloud);box-shadow:inset 0 0 0 1px var(--fc-fog);font-size:12.5px}
.fcsv-case{position:relative;display:flex;flex-direction:column;justify-content:flex-end;gap:8px;min-height:360px;padding:26px;border-radius:30px;overflow:hidden;color:var(--fc-cloud);text-decoration:none;isolation:isolate}
.fcsv-cph{position:absolute;inset:0;z-index:-1} .fcsv-cph img{width:100%;height:100%;object-fit:cover;transition:scale 1.2s cubic-bezier(.2,.8,.2,1)} .fcsv-case:hover .fcsv-cph img{scale:1.06} .fcsv-cph::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,color-mix(in srgb,var(--fc-night) 95%,transparent),color-mix(in srgb,var(--fc-night) 82%,transparent) 50%,color-mix(in srgb,var(--fc-night) 0.4%,transparent) 90%)}
.fcsv-cl{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--fc-brass)} .fcsv-case b{font-size:64px;font-weight:500;letter-spacing:-.06em;line-height:1} .fcsv-ct{font-size:15px;color:color-mix(in srgb,var(--fc-cloud) 82%,transparent)}
.fcsv-others{margin-top:clamp(70px,8vw,120px)} .fcsv-others>p{margin:0 0 16px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--fc-mut)} .fcsv-others>div{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}
.fcsv-others a{display:flex;flex-direction:column;gap:8px;padding:22px;border-radius:22px;background:var(--fc-cloud);box-shadow:inset 0 0 0 1px var(--fc-fog);color:var(--fc-ink);text-decoration:none;transition:background .3s,translate .4s cubic-bezier(.2,.8,.2,1)} .fcsv-others a:hover{background:var(--fc-brass);translate:0 -4px} .fcsv-others b{font-size:22px;font-weight:500;letter-spacing:-.03em} .fcsv-others span{font-size:12px;color:var(--fc-mut)}
.fcs-v{width:100%;max-width:470px;display:flex;flex-direction:column;gap:12px;font-size:13.5px}
/* voice */
.vv-top{display:flex;align-items:center;gap:8px;font-size:12px;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)} .vv-top i{width:8px;height:8px;border-radius:50%;background:#FF5A4E;animation:fcLed 1.2s infinite} .vv-top b{margin-left:auto;font-weight:500;color:var(--fc-cloud)}
.vv-wave{display:flex;align-items:center;gap:3px;height:80px} .vv-wave i{flex:1;height:var(--h);border-radius:2px;background:var(--fc-brass);transform-origin:50% 50%;animation:vvW 1.1s ease-in-out var(--d) infinite alternate} @keyframes vvW{from{transform:scaleY(.25)}to{transform:scaleY(1)}}
.vv-tx{display:flex;flex-direction:column;gap:8px} .vv-tx p{margin:0;display:flex;flex-direction:column;gap:3px;max-width:85%;padding:10px 13px;border-radius:14px;background:color-mix(in srgb,var(--fc-cloud) 8%,transparent)} .vv-tx p.a{align-self:flex-end;background:var(--fc-cloud);color:var(--fc-ink)} .vv-tx b{font-size:12px;letter-spacing:.14em;text-transform:uppercase;opacity:.6;font-weight:500}
.vv-chips{display:flex;gap:6px} .vv-chips span{padding:6px 10px;border-radius:999px;background:color-mix(in srgb,var(--fc-brass) 16%,transparent);color:var(--fc-brass);font-size:12px}
/* workflow */
.vf-step{display:flex;align-items:center;gap:12px;padding:13px 14px;border-radius:14px;background:color-mix(in srgb,var(--fc-cloud) 6%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-cloud) 8%,transparent);opacity:.72;translate:-10px 0;animation:vfOn 7s cubic-bezier(.2,.8,.2,1) calc(var(--i)*.9s) infinite}
.vf-step i{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:color-mix(in srgb,var(--fc-cloud) 10%,transparent);color:transparent} .vf-step span{flex:1} .vf-step b{font-size:12px;font-weight:500;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
@keyframes vfOn{0%{opacity:.72;translate:-10px 0}8%,80%{opacity:1;translate:0 0}8% ,80%{box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-brass) 45%,transparent)}100%{opacity:.72;translate:-10px 0}}
.vf-step{--ok:0} .vf-step i{animation:vfI 7s steps(1) calc(var(--i)*.9s + .5s) infinite} @keyframes vfI{0%{background:color-mix(in srgb,var(--fc-cloud) 10%,transparent);color:transparent}5%,75%{background:var(--fc-brass);color:var(--fc-ink)}100%{background:color-mix(in srgb,var(--fc-cloud) 10%,transparent);color:transparent}}
/* chat */
.v-chat p{margin:0;max-width:82%;padding:11px 14px;border-radius:16px;line-height:1.45} .v-chat .c{align-self:flex-end;background:var(--fc-brass);color:var(--fc-ink);border-bottom-right-radius:4px} .v-chat .a{background:color-mix(in srgb,var(--fc-cloud) 9%,transparent);border-bottom-left-radius:4px}
.v-chat .typing{display:flex;gap:5px;width:max-content} .v-chat .typing i{width:7px;height:7px;border-radius:50%;background:var(--fc-cloud);animation:vcT 1.2s ease-in-out infinite} .v-chat .typing i:nth-child(2){animation-delay:.15s} .v-chat .typing i:nth-child(3){animation-delay:.3s} @keyframes vcT{0%,100%{opacity:.25;translate:0 0}50%{opacity:1;translate:0 -3px}}
.vc-src{font-size:12px;letter-spacing:.04em;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
/* knowledge */
.vk-q{display:flex;align-items:center;gap:10px;padding:14px 16px;border-radius:14px;background:var(--fc-cloud);color:var(--fc-ink);font-size:14px} .vk-q svg{flex:none;color:var(--fc-mut)}
.vk-a{padding:16px;border-radius:14px;background:color-mix(in srgb,var(--fc-cloud) 7%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-brass) 30%,transparent)} .vk-a p{margin:0;line-height:1.55} .vk-a p b{color:var(--fc-brass);font-weight:600}
.vk-src{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px} .vk-src span{padding:5px 9px;border-radius:8px;background:color-mix(in srgb,var(--fc-cloud) 8%,transparent);font-size:12px}
/* app */
.va-row{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid color-mix(in srgb,var(--fc-cloud) 10%,transparent)} .va-row span{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
.va-total{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;padding-top:10px} .va-total span{font-size:12px;color:var(--fc-brass)} .va-total b{font-size:clamp(30px,9vw,44px);white-space:nowrap;font-weight:500;letter-spacing:-.05em;line-height:1}
.va-bar{height:6px;border-radius:9px;background:color-mix(in srgb,var(--fc-cloud) 10%,transparent);overflow:hidden} .va-bar i{display:block;height:100%;width:100%;background:var(--fc-brass);transform-origin:0 50%;animation:vaB 3.2s cubic-bezier(.7,0,.2,1) infinite} @keyframes vaB{0%{transform:scaleX(0)}60%,100%{transform:scaleX(1)}}

@media (max-width:1099px){.fcsv-tg,.fcsv-two{grid-template-columns:1fr}}
.fcsv.is-ph .fcsv-demo{min-height:340px}
