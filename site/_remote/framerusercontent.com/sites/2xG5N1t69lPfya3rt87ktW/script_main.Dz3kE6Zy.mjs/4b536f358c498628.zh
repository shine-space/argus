:where(.fc){position:relative;z-index:10} .fc,.fc *{box-sizing:border-box;min-width:0} .fc-sr{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip:rect(0 0 0 0)!important;white-space:nowrap!important;padding:0!important;margin:-1px!important;border:0!important} :where(.fc) a{color:inherit} html,body{overflow-x:clip}
:where(a[href],button,input,select,textarea,summary,[tabindex]:not([tabindex="-1"]),[role="button"]):focus-visible{outline:3px solid var(--fc-ink,#1D1830)!important;outline-offset:2px!important;box-shadow:0 0 0 2px var(--fc-bone,#EDE3D1)!important} :where(.fc-dark) :where(a[href],button,input,select,textarea,summary,[tabindex]:not([tabindex="-1"])):focus-visible{outline-color:var(--fc-cloud,#FFFFFF)!important;box-shadow:0 0 0 2px var(--fc-night,#0F1113)!important} :where(.fc-inring) :where(a[href],button):focus-visible{outline-offset:-4px!important;box-shadow:none!important} :where(.fc) :is(input:not([type=range]):not([type=checkbox]):not([type=radio]),textarea,select):focus-visible{outline:none!important;box-shadow:none!important} :where(.fc) textarea{resize:none} .fc-inring:focus-visible{outline-offset:-3px!important;box-shadow:none!important} html{scroll-padding-top:96px;scroll-padding-bottom:88px}
.fc-btn{position:relative;display:inline-flex;padding:0;min-height:54px;border-radius:999px;text-decoration:none;cursor:pointer;isolation:isolate;white-space:nowrap;font-size:14.5px;font-weight:600;letter-spacing:.005em;border:0;color:var(--fg);transition:transform .5s cubic-bezier(.2,.8,.2,1)}
.fc-cap{position:relative;display:inline-flex;align-items:center;gap:14px;width:100%;min-height:inherit;padding:0 7px 0 24px;border-radius:inherit;background:var(--face);overflow:hidden;box-shadow:inset 0 0 0 1.5px var(--edge);isolation:isolate}
.fc-cap::before{content:"";position:absolute;z-index:-1;inset:0;border-radius:inherit;background:var(--fill);clip-path:inset(0 100% 0 0 round 999px);transition:clip-path .55s cubic-bezier(.7,0,.2,1)}
.fc-btn:hover .fc-cap::before,.fc-btn:focus-visible .fc-cap::before{clip-path:inset(0 0 0 0 round 999px)}
.fc-btn:hover,.fc-btn:focus-visible{color:var(--fg2)}
.fc-btn.fc-noarr .fc-cap{padding-right:24px}
.fc-port{position:relative;width:9px;height:9px;flex:none;border-radius:50%;background:transparent;box-shadow:inset 0 0 0 2px currentColor;transition:background .3s,box-shadow .3s}
.fc-btn:hover .fc-port,.fc-btn:focus-visible .fc-port{background:var(--led);box-shadow:inset 0 0 0 2px var(--led),0 0 0 4px color-mix(in srgb,var(--led) 28%,transparent)}
.fc-arr{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;flex:none;background:var(--chip);color:var(--chipfg);transition:translate .5s cubic-bezier(.34,1.56,.64,1),rotate .5s cubic-bezier(.34,1.56,.64,1),background .3s,color .3s} .fc-btn:hover .fc-arr{rotate:-45deg}
.fc-lbl{position:relative;display:inline-block;height:1.2em;overflow:hidden;line-height:1.2} .fc-l1,.fc-l2{display:block;transition:translate .45s cubic-bezier(.7,0,.2,1)} .fc-btn:hover .fc-l1,.fc-btn:hover .fc-l2{translate:0 -100%}
.fc-btn.fc-solid{--face:var(--fc-ink);--edge:var(--fc-ink);--fill:var(--fc-brass);--fg:var(--fc-cloud);--fg2:var(--fc-ink);--led:var(--fc-ink);--chip:var(--fc-brass);--chipfg:var(--fc-ink)}
.fc-btn.fc-solid:hover{--chip:var(--fc-ink);--chipfg:var(--fc-brass)}
.fc-btn.fc-ghost{--face:transparent;--edge:color-mix(in srgb,var(--fc-ink) 22%,transparent);--fill:var(--fc-cloud);--fg:var(--fc-ink);--fg2:var(--fc-ink);--led:var(--fc-brass);--chip:var(--fc-ink);--chipfg:var(--fc-cloud)}
.fc-btn.fc-quiet{--face:color-mix(in srgb,var(--fc-cloud) 12%,transparent);--edge:color-mix(in srgb,var(--fc-cloud) 22%,transparent);--fill:var(--fc-brass);--fg:var(--fc-cloud);--fg2:var(--fc-ink);--led:var(--fc-ink);--chip:var(--fc-brass);--chipfg:var(--fc-ink)}
@media (max-width:600px),(hover:none){.fc .fc-btn{white-space:normal;text-align:left;line-height:1.25;min-height:52px;max-width:100%} .fc .fc-lbl{height:auto} .fc .fc-l2{display:none}}
.fc-btn:hover{transform:translate(var(--mx,0px),var(--my,0px))} .fc-btn:active{transform:translate(var(--mx,0px),var(--my,0px)) scale(.97)!important}
.fc-dark .fc-btn.fc-ghost{--face:color-mix(in srgb,var(--fc-cloud) 12%,transparent);--edge:color-mix(in srgb,var(--fc-cloud) 30%,transparent);--fill:var(--fc-cloud);--fg:var(--fc-cloud);--fg2:var(--fc-ink);--chip:var(--fc-cloud);--chipfg:var(--fc-ink)} .fc-dark .fc-btn.fc-ghost .fc-cap{-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
.fc-dark .fc-btn.fc-solid{--face:var(--fc-cloud);--edge:var(--fc-cloud);--fill:var(--fc-brass);--fg:var(--fc-ink);--fg2:var(--fc-ink);--chip:var(--fc-ink);--chipfg:var(--fc-cloud)}
/* TEXT-SAFE accents: mint is a FILL (ink text on it), a wire or a port; small mint TEXT on light grounds uses the darker --fc-acc. On dark grounds the mint itself reads. */
.fc{--fc-acc:color-mix(in srgb,var(--fc-brass) 40%,var(--fc-ink));--fc-acc-lg:color-mix(in srgb,var(--fc-brass) 62%,var(--fc-ink));--fc-mut:color-mix(in srgb,var(--fc-stone) 85%,var(--fc-ink));--fc-acc-d:var(--fc-brass)}
.fc-lt,.fc .fc-lt{--fc-acc:color-mix(in srgb,var(--fc-brass) 40%,var(--fc-ink));--fc-acc-lg:color-mix(in srgb,var(--fc-brass) 62%,var(--fc-ink));--fc-mut:color-mix(in srgb,var(--fc-stone) 85%,var(--fc-ink))}
.fc-dark,.fc.fc-dark{--fc-acc:var(--fc-brass);--fc-acc-lg:var(--fc-brass);--fc-mut:color-mix(in srgb,var(--fc-stone) 45%,var(--fc-cloud))}
/* LED segment strip (status rows) */
.fc-bar{width:26px;height:10px;flex:none;display:inline-block;background:repeating-linear-gradient(90deg,currentColor 0 1px,transparent 1px 3px,currentColor 3px 5px,transparent 5px 6px,currentColor 6px 7px,transparent 7px 9px,currentColor 9px 10px,transparent 10px 12px)}
@media (prefers-reduced-motion:reduce){.fc *,.sth *{animation-duration:.01ms!important;transition-duration:.01ms!important}}
.fccs-next:focus-visible,.fcpo-next:focus-visible,.fcw-row a:focus-visible,.fco-band:focus-visible,.fco-mq a:focus-visible{outline-offset:-4px!important;box-shadow:none!important}`,Yt=({s:e=15})=>x(`svg`,{width:e,height:e,viewBox:`0 0 24 24`,fill:`none`,stroke:`currentColor`,strokeWidth:`2`,strokeLinecap:`round`,strokeLinejoin:`round`,"aria-hidden":!0,children:x(`path`,{d:`M5 12h14M13 5l7 7-7 7`})}),L.Boolean,L.Number,Xt={site:[{slug:`site`,f1:`argus`,f2:"AI 自动化工作室",f3:"为团队打造日常使用的 AI 智能体与自动化流程，覆盖客服、销售运营和后台事务，数周即可上线。",f4:`hello@argus.ai`,f5:`+1 646 555 0187`,f6:"纽约",f7:`America/New_York`,f8:`/book`,f9:`X:https://x.com, LinkedIn:https://linkedin.com, YouTube:https://youtube.com`,f10:"第四季度项目预约中 · 剩余 3 个名额",f11:"美国纽约市西 21 街 54 号，邮编 10010",f12:"周一至周五 09:00–18:00（美国东部时间）",f13:`1-5 09:00-18:00`,n1:`1`}],services:[{slug:`voice-agents`,f1:"语音智能体",f2:"日夜在线的 AI 接待员，以自然语音接听每一通来电、安排预约并筛选意向客户。",f3:`0 missed`,f4:"非工作时间来电",f5:`voice`,f6:`Twilio, Vapi, Google Calendar, HubSpot`,f7:"围绕你的价格、政策和日历配置。来电者提出要求时，立即转交人工。",f8:"听取 50 通真实来电，梳理来电者的问题;制定语音风格、规则和人工接管条件;连接日历、CRM 和电话线路;与你的团队并行试运行一周",f9:"符合品牌风格的自然语音;预约、改约与确认;解答价格、营业时间和政策问题;按需转接人工;通话录音与摘要同步到 CRM",f10:`$8,500`,n1:`1`},{slug:`workflow-automation`,f1:"工作流自动化",f2:"工具之间的复制粘贴交给智能体：发票入账、CRM 更新、报告发送，自动完成。",f3:`31 h`,f4:"每人每月节省时间",f5:`workflow`,f6:`Make, n8n, Zapier, Xero, Slack`,f7:"先梳理流程，再自动化其中的重复步骤，需要判断的环节继续由人工负责。",f8:"跟进实际流程，记录每一步耗时;确定智能体负责什么、哪些环节由人工审批;构建工作流，加入日志与告警;提供操作手册与培训，完成交付",f9:"读取邮件、PDF 与表单;在你的工具之间流转数据;需要判断的环节由人工审批;出现异常时通过 Slack 告警;每月节省工时报告",f10:`$6,500`,n1:`2`},{slug:`support-agents`,f1:"客服智能体",f2:"根据文档和订单数据回答问题，能直接解决问题的聊天与邮件客服智能体。",f3:`68%`,f4:"无需人工解决的工单",f5:`support`,f6:`Zendesk, Intercom, Shopify, Gorgias`,f7:"每个回答都引用来源页面。不确定的问题会附上回复草稿交给你的团队。",f8:"阅读 500 张历史工单，按意图分类;连接客服系统、店铺和文档;编写答案与升级人工规则;先上线一个渠道，再逐步扩展",f9:"接入客服系统的聊天和邮件渠道;订单查询、退货与物流追踪;根据你的文档回答并引用来源;升级人工时附上回复草稿;每周准确率复盘",f10:`$9,500`,n1:`3`},{slug:`knowledge-base`,f1:"AI 知识库",f2:"一个搜索框，覆盖云盘、知识库和邮箱，用通俗语言回答，并附带来源。",f3:`9 s`,f4:"找到答案",f5:`knowledge`,f6:`Notion, Google Drive, Confluence, Slack`,f7:"公司专属，遵循现有访问权限，并随文件变化自动更新。",f8:"列出数据来源和访问权限;按权限索引云盘、知识库与邮箱;用 100 个真实问题测试答案;在 Slack 或 Teams 中发布",f9:"检索云盘、知识库与邮件;回答附带来源及页码;遵循现有访问权限;随文件变化保持同步;使用情况与知识缺口报告",f10:`$7,500`,n1:`4`},{slug:`custom-ai-apps`,f1:"定制 AI 应用",f2:"围绕模型打造内部工具：提案撰写、报价生成、线索评分。",f3:`4 wks`,f4:"从想法到工具上线",f5:`apps`,f6:`OpenAI, Anthropic, Supabase, Retool`,f7:"精巧实用的工具，让团队每天都愿意打开，并配备运营负责人所需的约束机制和日志。",f8:"找出最值得开发工具的那项任务;一周内与你的团队完成原型;开发时配置约束机制与日志;上线、培训并衡量成效",f9:"专注解决问题的内部工具;根据任务选用最合适的模型;访问控制与审计日志;由我们托管和维护;每月持续迭代",f10:`$12,000`,n1:`5`}],work:[{slug:`northwind-dental`,f1:`Northwind Dental`,f2:"医疗健康",f3:"让预约量提升 38% 的语音智能体",f4:`+38%`,f5:"预约量",f6:"六家诊所共用一条永不漏接的电话线。智能体直接在诊所管理软件中预约、改约和确认就诊。",f7:"语音智能体",img:`https://framerusercontent.com/images/OPO7hpxO5fFgicqBiebGwosE.webp`,f8:"六家诊所共用一条电话线。下午五点后和午休时，三分之一的来电无人接听，每一通漏接都意味着一次流失的预约。",f9:"语音智能体使用诊所的沟通风格，在诊所管理软件中预约、改约和确认就诊；涉及医疗判断的问题一律转交护士。",f10:"+38%|预约量;0|非工作时间漏接来电;4.8/5|来电者评分;11 h|每周为前台节省的时间",f11:"患者听不出这是智能体，前台终于有时间照顾现场的人了。",f12:"Dr. Sarah Kim, 医疗总监",f13:`4 weeks`,f14:`Vapi, Twilio, Dentrix, HubSpot`,n1:`1`},{slug:`ledgerly`,f1:`Ledgerly`,f2:"财会",f3:"月末结账从 9 天缩短至 2 天",f4:`2 days`,f5:"月末结账",f6:"由智能体核对发票、收据和银行流水，异常情况由人工审批。",f7:"工作流自动化",img:`https://framerusercontent.com/images/xC399cfk7wneLE2CiZd0LCKY70.webp`,f8:"月末结账耗时九天：需要在三个工具之间，手工核对 2,000 张发票、收据和银行流水。",f9:"发票智能体读取每份单据，与采购订单和银行流水核对，在 Xero 中入账，仅将异常情况交给人工处理。",f10:"2 天|月末结账;1,900|每周发票量;97%|无需人工匹配;9 h|每周节省时间",f11:"他们找出了我们每周浪费的九个小时，并将这些工作自动化。",f12:"Marcus Webb, 财务负责人",f13:`5 weeks`,f14:`n8n, Xero, Google Drive, Slack`,n1:`2`},{slug:`oakline-home`,f1:`Oakline Home`,f2:"电子商务",f3:"每 10 张客服工单中有 7 张由 AI 解决",f4:`71%`,f5:"工单由 AI 解决",f6:"根据 Shopify 数据，数秒内回答订单、退货与配送变更问题。",f7:"客服智能体",img:`https://framerusercontent.com/images/A1LSpWqZartLRT6sPWVxN0Ijbo.webp`,f8:"订单、退货和配送变更咨询挤满客服系统，高峰时段需要六小时才能回复。",f9:"通过聊天和邮件提供服务的客服智能体，根据 Shopify 数据和配送政策回答问题、处理退货，并在升级人工时附上回复草稿。",f10:"71%|工单由 AI 解决;38 s|首次回复;+9 分|CSAT;3x|每人处理工单量",f11:"71% 的工单无需人工处理，客户满意度也提升了。",f12:"Priya Nair, 客户体验负责人",f13:`4 weeks`,f14:`Gorgias, Shopify, OpenAI, Slack`,n1:`3`},{slug:`vantage-legal`,f1:`Vantage Legal`,f2:"法律服务",f3:"数秒找到每一份判例",f4:`9 s`,f5:"平均搜索用时",f6:"覆盖 14 年案件资料的私有知识库，遵循访问权限，回答附带来源。",f7:"AI 知识库",img:`https://framerusercontent.com/images/hPOHK0EMfYfzD6Gkwr40RfxeeRk.webp`,f8:"14 年的案件资料分散在文件夹中，只有合伙人才知道如何检索。",f9:"遵循访问权限的私有知识库，用通俗语言回答，并引用具体文档和页码。",f10:"9 s|平均搜索用时;14 年|年案件资料已索引;100%|回答附带来源;6 h|每位律师每周节省时间",f11:"这是我们的律师每天早上最先打开的工具。",f12:"Helen Park, 管理合伙人",f13:`6 weeks`,f14:`Anthropic, Pinecone, SharePoint, Teams`,n1:`4`},{slug:`brightpath-realty`,f1:`Brightpath Realty`,f2:"房地产",f3:"全天候响应，40 秒回复客户线索",f4:`40 s`,f5:"客户线索首次回复用时",f6:"每一条房产平台咨询，都会在经纪人查看前得到回复、看房时段及一条 CRM 记录。",f7:"工作流自动化",img:`https://framerusercontent.com/images/t7VGq6b8rzt8deI2pJExlQ61qzM.webp`,f8:"房产平台的咨询要等数小时才得到回复，那时买家早已联系了另外三位经纪人。",f9:"线索智能体在一分钟内回复，识别买家需求、提供看房时段，并在人工查看前写入 CRM。",f10:"40 s|首次回复;+27%|看房预约量;100%|线索已录入 CRM;24/7|覆盖时段",f11:"高效、细致，并坦诚说明 AI 的能力边界。",f12:"Daniel Ortiz，首席运营官",f13:`3 weeks`,f14:`Make, HubSpot, Google Calendar, WhatsApp`,n1:`5`}]},Zt=`FcHeader@cms1`,Qt=(e,t)=>e!=null&&String(e).trim()?String(e).trim():t,$t=(e,t=`img`)=>String(e&&e[t]||``).split(`?`)[0],en=`data:image/svg+xml;utf8,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%20400%20500'%20preserveAspectRatio%3D'xMidYMid%20slice'%3E%3Crect%20width%3D'400'%20height%3D'500'%20fill%3D'%23D3D8E2'%2F%3E%3Crect%20x%3D'120'%20y%3D'170'%20width%3D'160'%20height%3D'160'%20rx%3D'8'%20fill%3D'none'%20stroke%3D'%23AEB6C6'%20stroke-width%3D'1.5'%2F%3E%3Crect%20x%3D'100'%20y%3D'150'%20width%3D'200'%20height%3D'200'%20rx%3D'10'%20fill%3D'none'%20stroke%3D'%23C3CAD8'%20stroke-width%3D'1'%20stroke-dasharray%3D'2%206'%2F%3E%3C%2Fsvg%3E`,tn=(e,t=`img`)=>$t(e,t)||en,nn=c===void 0?E:n,rn=e=>String(e||``).split(`,`).map(e=>e.trim()).filter(Boolean).map(e=>{let t=e.indexOf(`:`);return{l:t<0?e:e.slice(0,t).trim(),h:t<0?`/`:e.slice(t+1).trim()}}),an={voice:`M4 12a8 8 0 1 1 16 0v5h-3v-5a5 5 0 0 0-10 0v5H4z`,workflow:`M5 6h6v4H5zM13 14h6v4h-6zM8 10v4h8`,support:`M4 6h16v10H8l-4 4z`,knowledge:`M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4.5-4.5`,apps:`M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z`},on=`
.fchd{position:fixed;left:0;right:0;top:0;bottom:auto!important;height:auto!important;z-index:1000;color:var(--fc-ink);pointer-events:none;--hp:12px;padding:14px calc(var(--g) - var(--hp)) 0;transition:translate .55s cubic-bezier(.2,.8,.2,1)}
.fchd.is-hide{translate:0 -120%}
.fchd-skip{position:absolute;left:12px;top:-60px;z-index:5;padding:10px 14px;border-radius:999px;background:var(--fc-ink);color:var(--fc-cloud);font-size:13px;text-decoration:none;pointer-events:auto} .fchd-skip:focus{top:12px}
.fchd-pill{pointer-events:auto;display:flex;align-items:center;gap:18px;max-width:calc(${Ft} + var(--hp)*2);margin:0 auto;padding:7px var(--hp);border-radius:999px;background:color-mix(in srgb,var(--fc-cloud) 72%,transparent);-webkit-backdrop-filter:blur(18px) saturate(1.4);backdrop-filter:blur(18px) saturate(1.4);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-ink) 10%,transparent),0 20px 50px -30px color-mix(in srgb,var(--fc-ink) 50%,transparent);transition:background .5s,box-shadow .5s,color .5s}
.fchd.is-dark .fchd-pill{background:color-mix(in srgb,var(--fc-night) 58%,transparent);color:var(--fc-cloud);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-cloud) 14%,transparent),0 20px 50px -30px #000}
.fchd-logo{display:flex;align-items:center;gap:8px;font-size:20px;font-weight:600;letter-spacing:-.04em;color:inherit;text-decoration:none;white-space:nowrap} .fchd-logo svg{fill:var(--fc-brass);animation:fcTw 3.2s ease-in-out infinite}
.fchd-nav{margin:0 auto} .fchd-nav ul{display:flex;gap:2px;list-style:none;margin:0;padding:0}
.fchd-nav a{position:relative;display:flex;align-items:center;gap:6px;padding:10px 14px;border-radius:999px;color:inherit;text-decoration:none;font-size:14.5px;font-weight:500;transition:background .25s} .fchd-nav a:hover{background:color-mix(in srgb,currentColor 9%,transparent)}
.fchd-nav a.is-cur::after{content:"";position:absolute;left:50%;bottom:3px;width:5px;height:5px;margin-left:-2.5px;border-radius:50%;background:var(--fc-brass);box-shadow:0 0 8px var(--fc-brass)}
.fchd-car{width:6px;height:6px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;rotate:45deg;translate:0 -2px;transition:rotate .3s} .fchd.is-mega .fchd-car{rotate:225deg;translate:0 2px}
.fchd-cta{min-height:46px;font-size:14px}
.fchd-burger{display:none;position:relative;width:46px;height:46px;border:0;border-radius:50%;background:var(--fc-ink);cursor:pointer;margin-left:auto} .fchd.is-dark .fchd-burger{background:var(--fc-cloud)} .fchd-burger i{position:absolute;left:14px;right:14px;height:2px;border-radius:2px;background:var(--fc-cloud)} .fchd.is-dark .fchd-burger i{background:var(--fc-ink)} .fchd-burger i:first-child{top:19px} .fchd-burger i:last-child{top:25px;right:19px}
.fchd-drawer{pointer-events:auto;position:relative;display:grid;grid-template-columns:1.5fr 1fr;gap:12px;max-width:1100px;margin:10px auto 0;padding:12px;border-radius:30px;background:color-mix(in srgb,var(--fc-night) 94%,transparent);-webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px);color:var(--fc-cloud);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-cloud) 12%,transparent),0 40px 80px -30px #000;clip-path:inset(0 0 100% 0 round 30px);visibility:hidden;transition:clip-path .5s cubic-bezier(.7,0,.2,1),visibility 0s .5s}
.fchd.is-mega .fchd-drawer{clip-path:inset(0 0 0 0 round 30px);visibility:visible;transition:clip-path .55s cubic-bezier(.7,0,.2,1),visibility 0s}
.fchd-list{padding:14px}
.fchd-dt{margin:0 0 10px;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
.fchd-list ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px}
.fchd-list li{opacity:0;translate:0 10px;transition:opacity .4s,translate .5s cubic-bezier(.2,.8,.2,1)} .fchd.is-mega .fchd-list li{opacity:1;translate:0 0;transition-delay:calc(.12s + var(--i)*.05s)}
.fchd-list li a{display:flex;align-items:center;gap:14px;padding:12px;border-radius:18px;color:inherit;text-decoration:none;transition:background .3s} .fchd-list li a.is-hv{background:color-mix(in srgb,var(--fc-cloud) 7%,transparent)}
.fchd-ic{display:grid;place-items:center;width:42px;height:42px;border-radius:14px;flex:none;background:color-mix(in srgb,var(--fc-brass) 14%,transparent);color:var(--fc-brass);transition:background .3s,color .3s} .fchd-list li a.is-hv .fchd-ic{background:var(--fc-brass);color:var(--fc-ink)}
.fchd-tx{display:flex;flex-direction:column;gap:3px;min-width:0;flex:1} .fchd-tx b{font-size:16px;font-weight:600;letter-spacing:-.02em} .fchd-tx em{font-style:normal;font-size:12.5px;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fchd-out{flex:none;font-size:12px;color:var(--fc-brass)}
.fchd-all{display:inline-flex;align-items:center;gap:6px;margin:10px 12px 4px;font-size:12px;letter-spacing:.06em;color:var(--fc-brass);text-decoration:none}
.fchd-feat{position:relative;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;min-height:280px;padding:20px;border-radius:22px;overflow:hidden;color:var(--fc-cloud);text-decoration:none;isolation:isolate}
.fchd-fph{position:absolute;inset:0;z-index:-1} .fchd-fph img{width:100%;height:100%;object-fit:cover;transition:scale 1s cubic-bezier(.2,.8,.2,1)} .fchd-feat:hover .fchd-fph img{scale:1.06} .fchd-fph::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,color-mix(in srgb,var(--fc-night) 90%,transparent),color-mix(in srgb,var(--fc-night) 0.4%,transparent) 70%)}
.fchd-fl{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--fc-brass)} .fchd-feat b{font-size:46px;font-weight:500;letter-spacing:-.05em;line-height:1} .fchd-ft{font-size:14px;line-height:1.4;color:color-mix(in srgb,var(--fc-cloud) 82%,transparent)}
/* phone sheet */
.fchd-sheet{position:fixed;inset:0;z-index:2000;display:flex;flex-direction:column;padding:16px 20px 24px;background:var(--fc-night);color:var(--fc-cloud);overflow-y:auto;animation:fchdIn .5s cubic-bezier(.2,.8,.2,1)} @keyframes fchdIn{from{clip-path:circle(0% at 92% 4%)}to{clip-path:circle(150% at 92% 4%)}}
.fchd-shtop{display:flex;align-items:center;justify-content:space-between;padding:4px 0 18px} .fchd-sheet .fchd-logo{color:var(--fc-cloud)}
.fchd-x{display:inline-flex;align-items:center;gap:10px;padding:12px 16px;border:0;border-radius:999px;background:color-mix(in srgb,var(--fc-cloud) 10%,transparent);color:var(--fc-cloud);font:inherit;font-size:12px;letter-spacing:.1em;text-transform:uppercase;cursor:pointer} .fchd-x i{position:relative;width:12px;height:12px} .fchd-x i::before,.fchd-x i::after{content:"";position:absolute;left:0;right:0;top:5px;height:2px;background:currentColor;rotate:45deg} .fchd-x i::after{rotate:-45deg}
.fchd-slinks{list-style:none;margin:10px 0 0;padding:0;display:flex;flex-direction:column}
.fchd-slinks li{border-bottom:1px solid color-mix(in srgb,var(--fc-cloud) 10%,transparent);animation:fchdL .6s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(.08s + var(--i)*.05s)} @keyframes fchdL{from{opacity:0;translate:0 16px}to{opacity:1;translate:0 0}}
.fchd-slinks a{display:flex;align-items:baseline;gap:14px;padding:14px 0;color:var(--fc-cloud);text-decoration:none;font-size:36px;font-weight:500;letter-spacing:-.045em} .fchd-slinks a[aria-current]{color:var(--fc-brass)} .fchd-slinks em{font-style:normal;font-size:12px;letter-spacing:.1em;color:var(--fc-brass)}
.fchd-schips{display:flex;flex-wrap:wrap;gap:6px;margin-top:22px} .fchd-schips a{padding:9px 13px;border-radius:999px;background:color-mix(in srgb,var(--fc-cloud) 8%,transparent);color:var(--fc-cloud);text-decoration:none;font-size:12px}
.fchd-sfoot{display:flex;flex-direction:column;gap:14px;margin-top:auto;padding-top:26px} .fchd-sfoot a:first-child{color:color-mix(in srgb,var(--fc-cloud) 78%,transparent);text-decoration:none;font-size:13px} .fchd-sfoot .fc-btn{width:100%}
