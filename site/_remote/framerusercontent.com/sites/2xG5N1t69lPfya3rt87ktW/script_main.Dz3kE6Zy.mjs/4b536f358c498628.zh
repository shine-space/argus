.fcld{display:none}html.fcld-go{overflow:hidden!important}html.fcld-go .fcld{display:block;animation:fcld-fb .8s ease 9s both}@keyframes fcld-fb{to{opacity:0;visibility:hidden}}
.fcld{position:fixed;inset:0;z-index:9999;pointer-events:auto;background:radial-gradient(ellipse at 50% 50%,color-mix(in srgb,var(--fc-pine) 70%,var(--fc-night)),var(--fc-night) 70%);color:var(--fc-cloud);--ir:0px}
.fcld *{box-sizing:border-box}
.fcld-open{-webkit-mask-image:radial-gradient(circle at 50% 50%,transparent var(--ir),#000 calc(var(--ir) + 1px));mask-image:radial-gradient(circle at 50% 50%,transparent var(--ir),#000 calc(var(--ir) + 1px));pointer-events:none}
.fcld-cv{position:absolute;inset:0;display:block}
.fcld-brand{position:absolute;left:0;right:0;top:50%;translate:0 -50%;margin:0;text-align:center;font-size:min(14vw,26vh,220px);font-weight:500;letter-spacing:-.05em;line-height:1;color:transparent;user-select:none}
.fcld-w{position:absolute;left:50%;bottom:clamp(40px,10vh,90px);translate:-50% 0;display:flex;gap:clamp(10px,2vw,26px);margin:0;padding:0;list-style:none;font-size:12px;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap;transition:opacity .3s}
.fcld-w li{display:flex;align-items:center;gap:8px;opacity:.28;transition:opacity .3s,color .3s} .fcld-w li i{position:relative;width:14px;height:14px;border-radius:50%;box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-cloud) 40%,transparent);transition:background .3s,box-shadow .3s}
.fcld-w li.is-on{opacity:.9} .fcld-w li.is-on i{box-shadow:inset 0 0 0 1.5px var(--fc-brass);animation:fcld-p .9s ease-in-out infinite} @keyframes fcld-p{50%{box-shadow:inset 0 0 0 1.5px var(--fc-brass),0 0 0 5px color-mix(in srgb,var(--fc-brass) 20%,transparent)}}
.fcld-w li.is-done{opacity:1} .fcld-w li.is-done i{background:var(--fc-brass);box-shadow:none} .fcld-w li.is-done i::after{content:"";position:absolute;left:4.5px;top:2.5px;width:3.5px;height:6.5px;border-right:1.6px solid var(--fc-night);border-bottom:1.6px solid var(--fc-night);rotate:45deg}
.fcld-core .fcld-w,.fcld-open .fcld-w{opacity:0}
@media (max-width:809px){.fcld-w{flex-direction:column;align-items:flex-start;gap:8px;font-size:12px}}
