.fco{position:relative;overflow:hidden;background:var(--fc-night);color:var(--fc-cloud);padding-bottom:10px;border-top:1px solid color-mix(in srgb,var(--fc-cloud) 8%,transparent)}
.fco-band{display:block;padding:clamp(30px,4vw,60px) 0;text-decoration:none;color:inherit;border-bottom:1px solid color-mix(in srgb,var(--fc-cloud) 10%,transparent)}
.fco-mq{overflow:hidden} .fco-tr{display:flex;width:max-content;animation:fcoMq 40s linear infinite} .fco-mq.r1 .fco-tr{animation-direction:reverse;animation-duration:48s} .fco-tr>span{display:flex}
.fco-band:hover .fco-tr{animation-play-state:paused}
.fco-w{display:inline-flex;align-items:center;gap:.25em;padding-right:.25em;font-size:clamp(64px,9vw,170px);font-weight:600;letter-spacing:-.06em;line-height:1.02;white-space:nowrap;color:transparent;-webkit-text-stroke:1.2px color-mix(in srgb,var(--fc-cloud) 45%,transparent);transition:color .5s,-webkit-text-stroke-color .5s}
.fco-mq.r1 .fco-w{color:color-mix(in srgb,var(--fc-cloud) 92%,transparent);-webkit-text-stroke-color:transparent}
.fco-band:hover .fco-mq.r0 .fco-w{color:var(--fc-brass);-webkit-text-stroke-color:var(--fc-brass)}
.fco-sp{width:.4em;height:.4em;fill:var(--fc-brass);flex:none}
@keyframes fcoMq{to{translate:-50% 0}}
.fco-grid{display:grid;grid-template-columns:1.6fr repeat(3,1fr);gap:clamp(24px,4vw,60px);padding:clamp(50px,6vw,90px) 0}
.fco-logo{display:inline-flex;align-items:center;gap:10px;font-size:26px;font-weight:600;letter-spacing:-.04em;color:var(--fc-cloud);text-decoration:none} .fco-logo .fco-sp{width:20px;height:20px}
.fco-tag{margin:18px 0 0;max-width:400px;font-size:15px;line-height:1.6;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
.fco-mail{display:inline-block;margin-top:28px;font-size:clamp(26px,2.4vw,40px);font-weight:500;letter-spacing:-.04em;color:var(--fc-cloud);text-decoration:none;background:linear-gradient(var(--fc-brass),var(--fc-brass)) 0 100%/0 2px no-repeat;transition:background-size .6s cubic-bezier(.2,.8,.2,1),color .3s} .fco-mail:hover{background-size:100% 2px;color:var(--fc-brass)}
.fco-meta{display:flex;flex-wrap:wrap;gap:6px 18px;margin:16px 0 0;font-size:12px;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)} .fco-meta a{color:var(--fc-brass);text-decoration:none}
.fco-col p{margin:0 0 16px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)} .fco-col ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px} .fco-col a{font-size:15px;color:var(--fc-cloud);text-decoration:none;display:inline-block;transition:translate .4s cubic-bezier(.2,.8,.2,1),color .3s} .fco-col a:hover{translate:6px 0;color:var(--fc-brass)}
.fco-base{display:flex;flex-wrap:wrap;align-items:center;gap:14px 28px;padding:24px 0 20px;border-top:1px solid color-mix(in srgb,var(--fc-cloud) 12%,transparent);font-size:12px;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
.fco-soc{display:flex;gap:18px;list-style:none;margin:0 0 0 auto;padding:0} .fco-soc a{color:var(--fc-cloud);text-decoration:none} .fco-soc a:hover{color:var(--fc-brass)}
.fco-top{display:inline-flex;align-items:center;gap:10px;color:var(--fc-cloud);text-decoration:none} .fco-top i{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:color-mix(in srgb,var(--fc-cloud) 10%,transparent);transition:background .3s,color .3s,translate .4s cubic-bezier(.34,1.56,.64,1)} .fco-top:hover i{background:var(--fc-brass);color:var(--fc-ink);translate:0 -4px}
@media (max-width:1099px){.fco-grid{grid-template-columns:1fr 1fr} .fco-lead{grid-column:1/-1}}
.fco.is-ph .fco-grid{grid-template-columns:1fr 1fr} .fco.is-ph .fco-soc{margin-left:0}
