.fc[data-kb] *,.fc[data-kb] *::before,.fc[data-kb] *::after{transition:none!important}
.fc-sec{position:relative;z-index:10;display:block;width:100%;--sp:.5;--pp:0}
.fc-rev{position:relative;width:100%;--rv:1} .fc-rev-in{position:relative} .fc-rev-sp{height:0}
.fc-rev.is-act{--rv:0;--t:min(var(--h),100vh);--t:min(var(--h),100svh);z-index:var(--layer,9);margin-top:calc(var(--t)*-1)}
.fc-rev.is-act>.fc-rev-in{position:sticky;top:calc(100vh - var(--t));top:calc(100svh - var(--t))} .fc-rev.is-act>.fc-rev-sp{height:var(--t)}
/* the lifting edge throws a shadow on the section beneath, and that section comes out of the dark as it is uncovered */
.fc-rev.is-act>.fc-rev-in::before{content:"";position:absolute;z-index:40;left:0;right:0;top:0;height:120px;translate:0 calc((1 - var(--rv))*var(--t));background:linear-gradient(180deg,rgba(0,0,0,.2),rgba(0,0,0,0));opacity:min(1,calc(var(--rv)*(1 - var(--rv))*9));pointer-events:none}
.fc-rev.is-act>.fc-rev-in::after{content:"";position:absolute;z-index:39;left:0;right:0;top:0;height:var(--t);background:#000;opacity:calc((1 - var(--rv))*.16);pointer-events:none}
.fc-wrap{--pad:56px;width:100%;max-width:calc(${ra} + var(--pad)*2);margin:0 auto;padding-left:var(--pad);padding-right:var(--pad)}
.fc-eb{display:inline-flex;align-items:center;gap:10px;width:max-content;max-width:100%;margin:0;padding:7px 14px 7px 8px;border-radius:999px;background:var(--fc-cloud);color:var(--fc-ink);box-shadow:inset 0 0 0 1px var(--fc-fog)!important;font-size:12px;letter-spacing:.1em;text-transform:uppercase;line-height:1.2;opacity:0;translate:0 10px;transition:opacity .7s ease,translate .8s cubic-bezier(.2,.8,.2,1);box-shadow:inset 0 1px 0 color-mix(in srgb,#fff 12%,transparent)} .fc-eb.is-on{opacity:1;translate:0 0}
.fc-eb i{position:relative;width:18px;height:18px;display:block;flex:none;border-radius:50%;background:var(--fc-brass)} .fc-eb i::after{content:"";position:absolute;inset:5px;border-radius:50%;border:2px solid var(--fc-ink);border-right-color:transparent;animation:fcSpin 1.2s linear infinite} @keyframes fcSpin{to{rotate:360deg}} @keyframes fcLed{0%,100%{opacity:1}50%{opacity:.35}}
.fc-dark .fc-eb{background:color-mix(in srgb,var(--fc-cloud) 8%,transparent);color:var(--fc-cloud);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-cloud) 16%,transparent)!important}
.fc-hd{margin:0;letter-spacing:-.045em;text-wrap:balance} .fc-hd-l{display:block}
.fc-hd-w{display:inline-block;overflow:hidden;vertical-align:top;padding:0 .05em .17em;margin:0 -.05em -.17em;white-space:pre}
.fc-hd-i{position:relative;display:inline-block;translate:0 108%;transition:translate 1s cubic-bezier(.2,.75,.2,1)}
.fc-hd.is-on .fc-hd-i{translate:0 0}
.fc-hd-w.is-accw{overflow:visible;clip-path:inset(-.6em -.6em .02em -.2em)}
.fc-it{position:relative;padding-right:.36em;background:linear-gradient(100deg,var(--fc-brass) 10%,color-mix(in srgb,var(--fc-brass) 35%,var(--fc-cloud)) 90%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent} :where(.fc:not(.fc-dark)) .fc-it{background:linear-gradient(100deg,var(--fc-ink) 10%,color-mix(in srgb,var(--fc-brass) 55%,var(--fc-ink)) 90%);-webkit-background-clip:text;background-clip:text}
.fc-spark{position:absolute;right:-.02em;top:.02em;width:.34em;height:.34em;overflow:visible;fill:var(--fc-brass);scale:0;rotate:-90deg;transition:scale .7s cubic-bezier(.34,1.56,.64,1) var(--pd,0ms),rotate .9s cubic-bezier(.2,.8,.2,1) var(--pd,0ms)}
.fc-hd.is-on .fc-spark{scale:1;rotate:0deg;animation:fcTw 3.2s ease-in-out calc(var(--pd,0ms) + 900ms) infinite} @keyframes fcTw{0%,100%{opacity:1;scale:1}50%{opacity:.55;scale:.72}}
.fc-um{position:relative;overflow:hidden;transition:clip-path 1.35s cubic-bezier(.7,0,.2,1);background:color-mix(in srgb,var(--fc-stone) 22%,transparent)}
.fc-um img{position:absolute;left:0;top:-9%;width:100%;height:118%;display:block;object-fit:cover;scale:1.28;translate:0 calc((var(--sp,.5) - .5)*var(--par,1)*-7%);transition:scale 1.9s cubic-bezier(.16,.84,.24,1);user-select:none}
.fc-um.is-on img{scale:1}
/* diagonal cuts: the section hangs over its neighbour and is cut on a slope (clip-path, so the neighbour shows through) */
.fc-cut-t{margin-top:calc(var(--cut,7vw)*-1);clip-path:polygon(0 var(--cut,7vw),100% 0,100% 100%,0 100%);padding-top:var(--cut,7vw)}
.fc-cut-b{margin-bottom:calc(var(--cut,7vw)*-1);padding-bottom:var(--cut,7vw)}
.fc-cut-t.fc-cut-b{clip-path:polygon(0 var(--cut,7vw),100% 0,100% calc(100% - var(--cut,7vw)),0 100%)}
.fc-cut-b:not(.fc-cut-t){clip-path:polygon(0 0,100% 0,100% calc(100% - var(--cut,7vw)),0 100%)}
@media (max-width:1099px){.fc-wrap{--pad:32px}}
@media (max-width:699px){.fc-wrap{--pad:20px}}
:root{--g:56px}@media (max-width:1099px){:root{--g:32px}}@media (max-width:699px){:root{--g:20px}}
@media (prefers-reduced-motion:reduce){.fc-hd-i{translate:0 0!important} .fc-spark{scale:1!important;rotate:0deg!important;animation:none!important} .fc-um{clip-path:none!important} .fc-um img{scale:1!important;translate:0 0!important}}
`,Ta={site:[{slug:`site`,f1:`argus`,f2:"AI 自动化工作室",f3:"为团队打造日常使用的 AI 智能体与自动化流程，覆盖客服、销售运营和后台事务，数周即可上线。",f4:`hello@argus.ai`,f5:`+1 646 555 0187`,f6:"纽约",f7:`America/New_York`,f8:`/book`,f9:`X:https://x.com, LinkedIn:https://linkedin.com, YouTube:https://youtube.com`,f10:"第四季度项目预约中 · 剩余 3 个名额",f11:"美国纽约市西 21 街 54 号，邮编 10010",f12:"周一至周五 09:00–18:00（美国东部时间）",f13:`1-5 09:00-18:00`,n1:`1`}],work:[{slug:`northwind-dental`,f1:`Northwind Dental`,f2:"医疗健康",f3:"让预约量提升 38% 的语音智能体",f4:`+38%`,f5:"预约量",f6:"六家诊所共用一条永不漏接的电话线。智能体直接在诊所管理软件中预约、改约和确认就诊。",f7:"语音智能体",img:`https://framerusercontent.com/images/OPO7hpxO5fFgicqBiebGwosE.webp`,f8:"六家诊所共用一条电话线。下午五点后和午休时，三分之一的来电无人接听，每一通漏接都意味着一次流失的预约。",f9:"语音智能体使用诊所的沟通风格，在诊所管理软件中预约、改约和确认就诊；涉及医疗判断的问题一律转交护士。",f10:"+38%|预约量;0|非工作时间漏接来电;4.8/5|来电者评分;11 h|每周为前台节省的时间",f11:"患者听不出这是智能体，前台终于有时间照顾现场的人了。",f12:"Dr. Sarah Kim, 医疗总监",f13:`4 weeks`,f14:`Vapi, Twilio, Dentrix, HubSpot`,n1:`1`},{slug:`ledgerly`,f1:`Ledgerly`,f2:"财会",f3:"月末结账从 9 天缩短至 2 天",f4:`2 days`,f5:"月末结账",f6:"由智能体核对发票、收据和银行流水，异常情况由人工审批。",f7:"工作流自动化",img:`https://framerusercontent.com/images/xC399cfk7wneLE2CiZd0LCKY70.webp`,f8:"月末结账耗时九天：需要在三个工具之间，手工核对 2,000 张发票、收据和银行流水。",f9:"发票智能体读取每份单据，与采购订单和银行流水核对，在 Xero 中入账，仅将异常情况交给人工处理。",f10:"2 天|月末结账;1,900|每周发票量;97%|无需人工匹配;9 h|每周节省时间",f11:"他们找出了我们每周浪费的九个小时，并将这些工作自动化。",f12:"Marcus Webb, 财务负责人",f13:`5 weeks`,f14:`n8n, Xero, Google Drive, Slack`,n1:`2`},{slug:`oakline-home`,f1:`Oakline Home`,f2:"电子商务",f3:"每 10 张客服工单中有 7 张由 AI 解决",f4:`71%`,f5:"工单由 AI 解决",f6:"根据 Shopify 数据，数秒内回答订单、退货与配送变更问题。",f7:"客服智能体",img:`https://framerusercontent.com/images/A1LSpWqZartLRT6sPWVxN0Ijbo.webp`,f8:"订单、退货和配送变更咨询挤满客服系统，高峰时段需要六小时才能回复。",f9:"通过聊天和邮件提供服务的客服智能体，根据 Shopify 数据和配送政策回答问题、处理退货，并在升级人工时附上回复草稿。",f10:"71%|工单由 AI 解决;38 s|首次回复;+9 分|CSAT;3x|每人处理工单量",f11:"71% 的工单无需人工处理，客户满意度也提升了。",f12:"Priya Nair, 客户体验负责人",f13:`4 weeks`,f14:`Gorgias, Shopify, OpenAI, Slack`,n1:`3`},{slug:`vantage-legal`,f1:`Vantage Legal`,f2:"法律服务",f3:"数秒找到每一份判例",f4:`9 s`,f5:"平均搜索用时",f6:"覆盖 14 年案件资料的私有知识库，遵循访问权限，回答附带来源。",f7:"AI 知识库",img:`https://framerusercontent.com/images/hPOHK0EMfYfzD6Gkwr40RfxeeRk.webp`,f8:"14 年的案件资料分散在文件夹中，只有合伙人才知道如何检索。",f9:"遵循访问权限的私有知识库，用通俗语言回答，并引用具体文档和页码。",f10:"9 s|平均搜索用时;14 年|年案件资料已索引;100%|回答附带来源;6 h|每位律师每周节省时间",f11:"这是我们的律师每天早上最先打开的工具。",f12:"Helen Park, 管理合伙人",f13:`6 weeks`,f14:`Anthropic, Pinecone, SharePoint, Teams`,n1:`4`},{slug:`brightpath-realty`,f1:`Brightpath Realty`,f2:"房地产",f3:"全天候响应，40 秒回复客户线索",f4:`40 s`,f5:"客户线索首次回复用时",f6:"每一条房产平台咨询，都会在经纪人查看前得到回复、看房时段及一条 CRM 记录。",f7:"工作流自动化",img:`https://framerusercontent.com/images/t7VGq6b8rzt8deI2pJExlQ61qzM.webp`,f8:"房产平台的咨询要等数小时才得到回复，那时买家早已联系了另外三位经纪人。",f9:"线索智能体在一分钟内回复，识别买家需求、提供看房时段，并在人工查看前写入 CRM。",f10:"40 s|首次回复;+27%|看房预约量;100%|线索已录入 CRM;24/7|覆盖时段",f11:"高效、细致，并坦诚说明 AI 的能力边界。",f12:"Daniel Ortiz，首席运营官",f13:`3 weeks`,f14:`Make, HubSpot, Google Calendar, WhatsApp`,n1:`5`}]},Ea=`FcWork@cms1`,Da=(e,t=`img`)=>String(e&&e[t]||``).split(`?`)[0],Oa=`data:image/svg+xml;utf8,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%20400%20500'%20preserveAspectRatio%3D'xMidYMid%20slice'%3E%3Crect%20width%3D'400'%20height%3D'500'%20fill%3D'%23D3D8E2'%2F%3E%3Crect%20x%3D'120'%20y%3D'170'%20width%3D'160'%20height%3D'160'%20rx%3D'8'%20fill%3D'none'%20stroke%3D'%23AEB6C6'%20stroke-width%3D'1.5'%2F%3E%3Crect%20x%3D'100'%20y%3D'150'%20width%3D'200'%20height%3D'200'%20rx%3D'10'%20fill%3D'none'%20stroke%3D'%23C3CAD8'%20stroke-width%3D'1'%20stroke-dasharray%3D'2%206'%2F%3E%3C%2Fsvg%3E`,ka=(e,t=`img`)=>Da(e,t)||Oa,Aa=a===void 0?h:r,ja=`
.fcw{position:relative;overflow:hidden;background:var(--fc-night);color:var(--fc-cloud);padding:clamp(100px,11vw,170px) 0 clamp(90px,10vw,150px)}
.fcw-head{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;margin-bottom:clamp(40px,5vw,80px)}
.fcw-list{list-style:none;margin:0;padding:0;border-top:1px solid color-mix(in srgb,var(--fc-cloud) 14%,transparent)}
.fcw-row{position:relative;border-bottom:1px solid color-mix(in srgb,var(--fc-cloud) 14%,transparent);clip-path:inset(0 0 100% 0);translate:0 40px;transition:clip-path 1s cubic-bezier(.7,0,.2,1) var(--d),translate 1s cubic-bezier(.2,.8,.2,1) var(--d)}
.fcw.is-on .fcw-row{clip-path:inset(0 0 0 0);translate:0 0}
.fcw-row a{position:relative;display:grid;grid-template-columns:60px 1fr auto;align-items:center;gap:clamp(20px,3vw,48px);padding:clamp(26px,3vw,44px) 0;color:inherit;text-decoration:none;transition:padding .6s cubic-bezier(.2,.8,.2,1),opacity .4s}
.fcw-list:hover .fcw-row:not(.is-hot) a{opacity:.35} .fcw-row.is-hot a{padding-left:20px}
.fcw-no{font-size:13px;color:var(--fc-brass)}
.fcw-mid{display:flex;flex-direction:column;gap:10px;min-width:0} .fcw-cl{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)} .fcw-t{font-size:clamp(28px,3vw,52px);font-weight:500;letter-spacing:-.045em;line-height:1.02}
.fcw-res{display:flex;flex-direction:column;align-items:flex-end;gap:4px;text-align:right} .fcw-res b{font-size:clamp(44px,4.6vw,84px);font-weight:500;letter-spacing:-.06em;line-height:.9;transition:color .4s} .fcw-row.is-hot .fcw-res b{color:var(--fc-brass)} .fcw-res em{font-style:normal;font-size:12.5px;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
.fcw-rule{position:absolute;left:0;right:0;bottom:-1px;height:2px;background:var(--fc-brass);transform:scaleX(0);transform-origin:0 50%;transition:transform .7s cubic-bezier(.7,0,.2,1)} .fcw-row.is-hot .fcw-rule{transform:scaleX(1)}
.fcw.has-float .fcw-row a{cursor:none}
.fcw-float{position:absolute;z-index:20;left:0;top:0;width:clamp(300px,24vw,400px);aspect-ratio:4/5;pointer-events:none;opacity:0;scale:.6;transition:opacity .35s,scale .5s cubic-bezier(.2,.8,.2,1);will-change:transform}
.fcw-fi{position:absolute;inset:0;border-radius:22px;overflow:hidden;clip-path:inset(100% 0 0 0 round 22px);transition:clip-path .7s cubic-bezier(.7,0,.2,1)} .fcw-fi.is-on{clip-path:inset(0 0 0 0 round 22px);z-index:1}
.fcw-fi img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;scale:1.15;transition:scale 1s cubic-bezier(.2,.8,.2,1)} .fcw-fi.is-on img{scale:1}
.fcw-fi span{position:absolute;left:14px;right:14px;bottom:14px;padding:9px 12px;border-radius:12px;background:color-mix(in srgb,var(--fc-night) 60%,transparent);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);font-size:12px;letter-spacing:.04em}
.fcw-lab{position:absolute;z-index:3;left:-34px;top:120px;display:grid;place-items:center;width:84px;height:84px;border-radius:50%;background:var(--fc-brass);color:var(--fc-ink);font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;text-align:center;line-height:1.2;padding:0 10px}
.fcw.is-ph .fcw-head{flex-direction:column;align-items:flex-start} .fcw.is-ph .fcw-row a{grid-template-columns:1fr;gap:12px;padding:26px 0} .fcw.is-ph .fcw-no{display:none} .fcw.is-ph .fcw-res{align-items:flex-start;text-align:left;flex-direction:row;align-items:baseline;gap:10px}
.fcw.is-ph .fcw-phimg{position:relative;display:block;aspect-ratio:16/10;border-radius:18px;overflow:hidden;order:-1} .fcw.is-ph .fcw-phimg img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
