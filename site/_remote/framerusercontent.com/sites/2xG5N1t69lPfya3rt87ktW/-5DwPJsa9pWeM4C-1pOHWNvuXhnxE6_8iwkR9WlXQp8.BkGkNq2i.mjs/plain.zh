.fca-core i{position:absolute;inset:-14px;border-radius:50%;border:1px solid color-mix(in srgb,var(--fc-brass) 50%,transparent);animation:fcaPulse 2.4s ease-out infinite} @keyframes fcaPulse{from{scale:.9;opacity:.8}to{scale:1.5;opacity:0}}
.fca-core b{position:absolute;bottom:-26px;font-size:12px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
.fca-list{position:absolute;inset:0;list-style:none;margin:0;padding:0}
.fca-a{position:absolute;left:50%;top:50%;display:flex;align-items:center;gap:9px;margin:-26px 0 0 -100px;height:52px;padding:0 18px 0 12px;border-radius:999px;white-space:nowrap;background:color-mix(in srgb,var(--fc-pine) 94%,transparent);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-cloud) 14%,transparent);font-size:15.5px;cursor:default;outline:none;will-change:transform;transition:background .35s,box-shadow .35s}
.fca-dot{width:22px;height:22px;border-radius:50%;flex:none;background:radial-gradient(circle,var(--fc-brass) 30%,color-mix(in srgb,var(--fc-brass) 18%,transparent) 32%)}
.fca-a b{font-weight:600} .fca-a em{font-style:normal;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:color-mix(in srgb,var(--fc-cloud) 90%,transparent)}
.fca-res{max-width:0;overflow:hidden;opacity:0;font-size:20px;font-weight:500;letter-spacing:-.03em;color:var(--fc-ink);transition:max-width .5s cubic-bezier(.2,.8,.2,1),opacity .3s,margin .5s}
