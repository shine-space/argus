.fc[data-kb] *,.fc[data-kb] *::before,.fc[data-kb] *::after{transition:none!important}
.fc-sec{position:relative;z-index:10;display:block;width:100%;--sp:.5;--pp:0}
.fc-rev{position:relative;width:100%;--rv:1} .fc-rev-in{position:relative} .fc-rev-sp{height:0}
.fc-rev.is-act{--rv:0;--t:min(var(--h),100vh);--t:min(var(--h),100svh);z-index:var(--layer,9);margin-top:calc(var(--t)*-1)}
.fc-rev.is-act>.fc-rev-in{position:sticky;top:calc(100vh - var(--t));top:calc(100svh - var(--t))} .fc-rev.is-act>.fc-rev-sp{height:var(--t)}
/* the lifting edge throws a shadow on the section beneath, and that section comes out of the dark as it is uncovered */
.fc-rev.is-act>.fc-rev-in::before{content:"";position:absolute;z-index:40;left:0;right:0;top:0;height:120px;translate:0 calc((1 - var(--rv))*var(--t));background:linear-gradient(180deg,rgba(0,0,0,.2),rgba(0,0,0,0));opacity:min(1,calc(var(--rv)*(1 - var(--rv))*9));pointer-events:none}
.fc-rev.is-act>.fc-rev-in::after{content:"";position:absolute;z-index:39;left:0;right:0;top:0;height:var(--t);background:#000;opacity:calc((1 - var(--rv))*.16);pointer-events:none}
.fc-wrap{--pad:56px;width:100%;max-width:calc(${yi} + var(--pad)*2);margin:0 auto;padding-left:var(--pad);padding-right:var(--pad)}
.fc-eb{display:inline-flex;align-items:center;gap:10px;width:max-content;max-width:100%;margin:0;padding:7px 14px 7px 8px;border-radius:999px;background:var(--fc-cloud);color:var(--fc-ink);box-shadow:inset 0 0 0 1px var(--fc-fog)!important;font-size:12px;letter-spacing:.1em;text-transform:uppercase;line-height:1.2;opacity:0;translate:0 10px;transition:opacity .7s ease,translate .8s cubic-bezier(.2,.8,.2,1);box-shadow:inset 0 1px 0 color-mix(in srgb,#fff 12%,transparent)} .fc-eb.is-on{opacity:1;translate:0 0}
.fc-eb i{position:relative;width:18px;height:18px;display:block;flex:none;border-radius:50%;background:var(--fc-brass)} .fc-eb i::after{content:"";position:absolute;inset:5px;border-radius:50%;border:2px solid var(--fc-ink);border-right-color:transparent;animation:fcSpin 1.2s linear infinite} @keyframes fcSpin{to{rotate:360deg}} @keyframes fcLed{0%,100%{opacity:1}50%{opacity:.35}}
.fc-dark .fc-eb{background:color-mix(in srgb,var(--fc-cloud) 8%,transparent);color:var(--fc-cloud);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-cloud) 16%,transparent)!important}
.fc-hd{margin:0;letter-spacing:-.045em;text-wrap:balance} .fc-hd-l{display:block}
.fc-hd-w{display:inline-block;overflow:hidden;vertical-align:top;padding:0 .05em .17em;margin:0 -.05em -.17em;white-space:pre}
.fc-hd-i{position:relative;display:inline-block;translate:0 108%;transition:translate 1s cubic-bezier(.2,.75,.2,1)}
.fc-hd.is-on .fc-hd-i{translate:0 0}
.fc-hd-w.is-accw{overflow:visible;clip-path:inset(-.6em -.6em .02em -.2em)}
.fc-it{position:relative;padding-right:.36em;background:linear-gradient(100deg,var(--fc-brass) 10%,color-mix(in srgb,var(--fc-brass) 35%,var(--fc-cloud)) 90%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent} :where(.fc:not(.fc-dark)) .fc-it{background:linear-gradient(100deg,var(--fc-ink) 10%,color-mix(in srgb,var(--fc-brass) 55%,var(--fc-ink)) 90%);-webkit-background-clip:text;background-clip:text}
.fc-spark{position:absolute;right:-.02em;top:.02em;width:.34em;height:.34em;overflow:visible;fill:var(--fc-brass);scale:0;rotate:-90deg;transition:scale .7s cubic-bezier(.34,1.56,.64,1) var(--pd,0ms),rotate .9s cubic-bezier(.2,.8,.2,1) var(--pd,0ms)}
.fc-hd.is-on .fc-spark{scale:1;rotate:0deg;animation:fcTw 3.2s ease-in-out calc(var(--pd,0ms) + 900ms) infinite} @keyframes fcTw{0%,100%{opacity:1;scale:1}50%{opacity:.55;scale:.72}}
.fc-um{position:relative;overflow:hidden;transition:clip-path 1.35s cubic-bezier(.7,0,.2,1);background:color-mix(in srgb,var(--fc-stone) 22%,transparent)}
.fc-um img{position:absolute;left:0;top:-9%;width:100%;height:118%;display:block;object-fit:cover;scale:1.28;translate:0 calc((var(--sp,.5) - .5)*var(--par,1)*-7%);transition:scale 1.9s cubic-bezier(.16,.84,.24,1);user-select:none}
.fc-um.is-on img{scale:1}
/* diagonal cuts: the section hangs over its neighbour and is cut on a slope (clip-path, so the neighbour shows through) */
.fc-cut-t{margin-top:calc(var(--cut,7vw)*-1);clip-path:polygon(0 var(--cut,7vw),100% 0,100% 100%,0 100%);padding-top:var(--cut,7vw)}
.fc-cut-b{margin-bottom:calc(var(--cut,7vw)*-1);padding-bottom:var(--cut,7vw)}
.fc-cut-t.fc-cut-b{clip-path:polygon(0 var(--cut,7vw),100% 0,100% calc(100% - var(--cut,7vw)),0 100%)}
.fc-cut-b:not(.fc-cut-t){clip-path:polygon(0 0,100% 0,100% calc(100% - var(--cut,7vw)),0 100%)}
@media (max-width:1099px){.fc-wrap{--pad:32px}}
@media (max-width:699px){.fc-wrap{--pad:20px}}
:root{--g:56px}@media (max-width:1099px){:root{--g:32px}}@media (max-width:699px){:root{--g:20px}}
@media (prefers-reduced-motion:reduce){.fc-hd-i{translate:0 0!important} .fc-spark{scale:1!important;rotate:0deg!important;animation:none!important} .fc-um{clip-path:none!important} .fc-um img{scale:1!important;translate:0 0!important}}
`,Bi={site:[{slug:`site`,f1:`argus`,f2:"AI 自动化工作室",f3:"为团队打造日常使用的 AI 智能体与自动化流程，覆盖客服、销售运营和后台事务，数周即可上线。",f4:`hello@argus.ai`,f5:`+1 646 555 0187`,f6:"纽约",f7:`America/New_York`,f8:`/book`,f9:`X:https://x.com, LinkedIn:https://linkedin.com, YouTube:https://youtube.com`,f10:"第四季度项目预约中 · 剩余 3 个名额",f11:"美国纽约市西 21 街 54 号，邮编 10010",f12:"周一至周五 09:00–18:00（美国东部时间）",f13:`1-5 09:00-18:00`,n1:`1`}],services:[{slug:`voice-agents`,f1:"语音智能体",f2:"日夜在线的 AI 接待员，以自然语音接听每一通来电、安排预约并筛选意向客户。",f3:`0 missed`,f4:"非工作时间来电",f5:`voice`,f6:`Twilio, Vapi, Google Calendar, HubSpot`,f7:"围绕你的价格、政策和日历配置。来电者提出要求时，立即转交人工。",f8:"听取 50 通真实来电，梳理来电者的问题;制定语音风格、规则和人工接管条件;连接日历、CRM 和电话线路;与你的团队并行试运行一周",f9:"符合品牌风格的自然语音;预约、改约与确认;解答价格、营业时间和政策问题;按需转接人工;通话录音与摘要同步到 CRM",f10:`$8,500`,n1:`1`},{slug:`workflow-automation`,f1:"工作流自动化",f2:"工具之间的复制粘贴交给智能体：发票入账、CRM 更新、报告发送，自动完成。",f3:`31 h`,f4:"每人每月节省时间",f5:`workflow`,f6:`Make, n8n, Zapier, Xero, Slack`,f7:"先梳理流程，再自动化其中的重复步骤，需要判断的环节继续由人工负责。",f8:"跟进实际流程，记录每一步耗时;确定智能体负责什么、哪些环节由人工审批;构建工作流，加入日志与告警;提供操作手册与培训，完成交付",f9:"读取邮件、PDF 与表单;在你的工具之间流转数据;需要判断的环节由人工审批;出现异常时通过 Slack 告警;每月节省工时报告",f10:`$6,500`,n1:`2`},{slug:`support-agents`,f1:"客服智能体",f2:"根据文档和订单数据回答问题，能直接解决问题的聊天与邮件客服智能体。",f3:`68%`,f4:"无需人工解决的工单",f5:`support`,f6:`Zendesk, Intercom, Shopify, Gorgias`,f7:"每个回答都引用来源页面。不确定的问题会附上回复草稿交给你的团队。",f8:"阅读 500 张历史工单，按意图分类;连接客服系统、店铺和文档;编写答案与升级人工规则;先上线一个渠道，再逐步扩展",f9:"接入客服系统的聊天和邮件渠道;订单查询、退货与物流追踪;根据你的文档回答并引用来源;升级人工时附上回复草稿;每周准确率复盘",f10:`$9,500`,n1:`3`},{slug:`knowledge-base`,f1:"AI 知识库",f2:"一个搜索框，覆盖云盘、知识库和邮箱，用通俗语言回答，并附带来源。",f3:`9 s`,f4:"找到答案",f5:`knowledge`,f6:`Notion, Google Drive, Confluence, Slack`,f7:"公司专属，遵循现有访问权限，并随文件变化自动更新。",f8:"列出数据来源和访问权限;按权限索引云盘、知识库与邮箱;用 100 个真实问题测试答案;在 Slack 或 Teams 中发布",f9:"检索云盘、知识库与邮件;回答附带来源及页码;遵循现有访问权限;随文件变化保持同步;使用情况与知识缺口报告",f10:`$7,500`,n1:`4`},{slug:`custom-ai-apps`,f1:"定制 AI 应用",f2:"围绕模型打造内部工具：提案撰写、报价生成、线索评分。",f3:`4 wks`,f4:"从想法到工具上线",f5:`apps`,f6:`OpenAI, Anthropic, Supabase, Retool`,f7:"精巧实用的工具，让团队每天都愿意打开，并配备运营负责人所需的约束机制和日志。",f8:"找出最值得开发工具的那项任务;一周内与你的团队完成原型;开发时配置约束机制与日志;上线、培训并衡量成效",f9:"专注解决问题的内部工具;根据任务选用最合适的模型;访问控制与审计日志;由我们托管和维护;每月持续迭代",f10:`$12,000`,n1:`5`}]},Vi=`FcServices@cms1`,Hi=a===void 0?h:r,Ui=`
.fcs{position:relative;height:calc(var(--n)*55vh + 100vh);background:var(--fc-night);color:var(--fc-cloud)}
.fcs-stage{position:sticky;top:0;height:100vh;height:100svh;display:flex;flex-direction:column;justify-content:center;gap:clamp(20px,3vh,36px);overflow:hidden}
.fcs-head{display:flex;align-items:flex-end;justify-content:space-between;gap:30px} .fcs-head .fc-btn{flex:none}
.fcs-prog{display:flex;align-items:center;gap:18px} .fcs-prog span{font-size:12px;letter-spacing:.1em;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)} .fcs-prog i{position:relative;width:120px;height:2px;background:color-mix(in srgb,var(--fc-cloud) 14%,transparent);overflow:hidden} .fcs-prog b{position:absolute;inset:0;background:var(--fc-brass);transform-origin:0 50%;transform:scaleX(var(--pp,0))}
.fcs-row{position:relative;list-style:none;margin:0;padding:0;height:min(62vh,600px)}
.fcs-p{position:absolute;left:0;top:0;bottom:0;border-radius:26px;overflow:hidden;background:color-mix(in srgb,var(--fc-pine) 70%,var(--fc-night));transition:transform .9s cubic-bezier(.7,0,.2,1),clip-path .9s cubic-bezier(.7,0,.2,1),background .6s;will-change:transform}
.fcs-p.is-open{background:var(--fc-pine)} .fcs-p:nth-child(2).is-open{background:color-mix(in srgb,var(--fc-brass) 88%,#000);color:var(--fc-ink)} .fcs-p:nth-child(4).is-open{background:var(--fc-cloud);color:var(--fc-ink)}
.fcs-strip{position:absolute;left:0;top:0;bottom:0;width:var(--cw,100%);z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:space-between;padding:22px 0;border:0;background:none;color:inherit;cursor:pointer;font:inherit;transition:opacity .4s}
.fcs-p.is-open .fcs-strip{opacity:0;pointer-events:none}
.fcs-idx{font-size:12px;color:var(--fc-brass)} .fcs-vt{writing-mode:vertical-rl;rotate:180deg;font-size:clamp(20px,1.7vw,28px);font-weight:500;letter-spacing:-.03em;white-space:nowrap} .fcs-plus{position:relative;width:34px;height:34px;border-radius:50%;box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-cloud) 30%,transparent)} .fcs-plus::before,.fcs-plus::after{content:"";position:absolute;left:50%;top:50%;width:12px;height:1.5px;margin:-.75px 0 0 -6px;background:currentColor} .fcs-plus::after{rotate:90deg}
.fcs-p:not(.is-open):hover{box-shadow:none;background:color-mix(in srgb,var(--fc-pine) 90%,var(--fc-brass))}
.fcs-body{position:absolute;inset:0;display:grid;grid-template-columns:1fr 1fr;gap:clamp(20px,3vw,48px);padding:clamp(26px,3vw,46px);opacity:0;translate:40px 0;transition:opacity .5s ease,translate .8s cubic-bezier(.2,.8,.2,1);pointer-events:none}
.fcs-p.is-open .fcs-body{opacity:1;translate:0 0;transition-delay:.35s;pointer-events:auto}
.fcs-copy{display:flex;flex-direction:column;gap:16px}
.fcs-copy h3{margin:0;font-size:clamp(40px,4.4vw,78px);font-weight:500;letter-spacing:-.05em;line-height:.95}
.fcs-short{margin:0;max-width:440px;font-size:clamp(17px,1.35vw,21px);line-height:1.45}
.fcs-det{margin:0;max-width:420px;font-size:15px;line-height:1.6;opacity:.7}
.fcs-tools{display:flex;flex-wrap:wrap;gap:6px} .fcs-tools span{padding:6px 11px;border-radius:999px;font-size:12px;box-shadow:inset 0 0 0 1px currentColor;opacity:.7}
.fcs-out{margin-top:auto;display:flex;align-items:baseline;gap:14px;padding-top:20px;border-top:1px solid color-mix(in srgb,currentColor 20%,transparent)} .fcs-out b{font-size:clamp(40px,3.8vw,64px);font-weight:500;letter-spacing:-.05em;line-height:1} .fcs-out span{font-size:14px;opacity:.7;max-width:200px}
.fcs-demo{display:flex;align-items:center;justify-content:center;border-radius:20px;background:var(--fc-night);color:var(--fc-cloud);padding:clamp(18px,2vw,28px);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-cloud) 10%,transparent);overflow:hidden}
.fcs-v{width:100%;max-width:470px;display:flex;flex-direction:column;gap:12px;font-size:13.5px}
/* voice */
.vv-top{display:flex;align-items:center;gap:8px;font-size:12px;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)} .vv-top i{width:8px;height:8px;border-radius:50%;background:#FF5A4E;animation:fcLed 1.2s infinite} .vv-top b{margin-left:auto;font-weight:500;color:var(--fc-cloud)}
.vv-wave{display:flex;align-items:center;gap:3px;height:80px} .vv-wave i{flex:1;height:var(--h);border-radius:2px;background:var(--fc-brass);transform-origin:50% 50%;animation:vvW 1.1s ease-in-out var(--d) infinite alternate} @keyframes vvW{from{transform:scaleY(.25)}to{transform:scaleY(1)}}
.vv-tx{display:flex;flex-direction:column;gap:8px} .vv-tx p{margin:0;display:flex;flex-direction:column;gap:3px;max-width:85%;padding:10px 13px;border-radius:14px;background:color-mix(in srgb,var(--fc-cloud) 8%,transparent)} .vv-tx p.a{align-self:flex-end;background:var(--fc-cloud);color:var(--fc-ink)} .vv-tx b{font-size:12px;letter-spacing:.14em;text-transform:uppercase;opacity:.6;font-weight:500}
.vv-chips{display:flex;gap:6px} .vv-chips span{padding:6px 10px;border-radius:999px;background:color-mix(in srgb,var(--fc-brass) 16%,transparent);color:var(--fc-brass);font-size:12px}
/* workflow */
.vf-step{display:flex;align-items:center;gap:12px;padding:13px 14px;border-radius:14px;background:color-mix(in srgb,var(--fc-cloud) 6%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-cloud) 8%,transparent);opacity:.72;translate:-10px 0;animation:vfOn 7s cubic-bezier(.2,.8,.2,1) calc(var(--i)*.9s) infinite}
.vf-step i{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:color-mix(in srgb,var(--fc-cloud) 10%,transparent);color:transparent} .vf-step span{flex:1} .vf-step b{font-size:12px;font-weight:500;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
@keyframes vfOn{0%{opacity:.72;translate:-10px 0}8%,80%{opacity:1;translate:0 0}8% ,80%{box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-brass) 45%,transparent)}100%{opacity:.72;translate:-10px 0}}
.vf-step{--ok:0} .vf-step i{animation:vfI 7s steps(1) calc(var(--i)*.9s + .5s) infinite} @keyframes vfI{0%{background:color-mix(in srgb,var(--fc-cloud) 10%,transparent);color:transparent}5%,75%{background:var(--fc-brass);color:var(--fc-ink)}100%{background:color-mix(in srgb,var(--fc-cloud) 10%,transparent);color:transparent}}
/* chat */
.v-chat p{margin:0;max-width:82%;padding:11px 14px;border-radius:16px;line-height:1.45} .v-chat .c{align-self:flex-end;background:var(--fc-brass);color:var(--fc-ink);border-bottom-right-radius:4px} .v-chat .a{background:color-mix(in srgb,var(--fc-cloud) 9%,transparent);border-bottom-left-radius:4px}
.v-chat .typing{display:flex;gap:5px;width:max-content} .v-chat .typing i{width:7px;height:7px;border-radius:50%;background:var(--fc-cloud);animation:vcT 1.2s ease-in-out infinite} .v-chat .typing i:nth-child(2){animation-delay:.15s} .v-chat .typing i:nth-child(3){animation-delay:.3s} @keyframes vcT{0%,100%{opacity:.25;translate:0 0}50%{opacity:1;translate:0 -3px}}
.vc-src{font-size:12px;letter-spacing:.04em;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
/* knowledge */
.vk-q{display:flex;align-items:center;gap:10px;padding:14px 16px;border-radius:14px;background:var(--fc-cloud);color:var(--fc-ink);font-size:14px} .vk-q svg{flex:none;color:var(--fc-mut)}
.vk-a{padding:16px;border-radius:14px;background:color-mix(in srgb,var(--fc-cloud) 7%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-brass) 30%,transparent)} .vk-a p{margin:0;line-height:1.55} .vk-a p b{color:var(--fc-brass);font-weight:600}
.vk-src{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px} .vk-src span{padding:5px 9px;border-radius:8px;background:color-mix(in srgb,var(--fc-cloud) 8%,transparent);font-size:12px}
/* app */
.va-row{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid color-mix(in srgb,var(--fc-cloud) 10%,transparent)} .va-row span{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
.va-total{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;padding-top:10px} .va-total span{font-size:12px;color:var(--fc-brass)} .va-total b{font-size:clamp(30px,9vw,44px);white-space:nowrap;font-weight:500;letter-spacing:-.05em;line-height:1}
.va-bar{height:6px;border-radius:9px;background:color-mix(in srgb,var(--fc-cloud) 10%,transparent);overflow:hidden} .va-bar i{display:block;height:100%;width:100%;background:var(--fc-brass);transform-origin:0 50%;animation:vaB 3.2s cubic-bezier(.7,0,.2,1) infinite} @keyframes vaB{0%{transform:scaleX(0)}60%,100%{transform:scaleX(1)}}

.fcs.is-still{height:auto} .fcs.is-still .fcs-stage{position:relative;height:auto;padding:120px 0}
.fcs.is-ph{height:auto} .fcs.is-ph .fcs-stage{position:relative;height:auto;padding:90px 0}
.fcs.is-ph .fcs-row{display:flex;flex-direction:column;height:auto;gap:8px} .fcs.is-ph .fcs-p{position:relative;transition:none} .fcs.is-ph .fcs-strip{width:auto} .fcs.is-ph .fcs-strip{position:relative;flex-direction:row;padding:20px;gap:14px;justify-content:flex-start} .fcs.is-ph .fcs-vt{writing-mode:horizontal-tb;rotate:none;font-size:22px;white-space:normal;min-width:0;text-align:left} .fcs.is-ph .fcs-plus{margin-left:auto;flex:none}
.fcs.is-ph .fcs-p.is-open .fcs-strip{height:0;padding:0;overflow:hidden;opacity:0} .fcs-p.is-kb::after{content:"";position:absolute;inset:3px;border-radius:24px;box-shadow:inset 0 0 0 3px var(--fc-cloud),inset 0 0 0 5px var(--fc-night);pointer-events:none;z-index:6} .fcs-strip:focus-visible{outline:none!important} .fcs.is-ph .fcs-body{position:relative;display:none;grid-template-columns:1fr;min-width:0;padding:22px;opacity:1;translate:none} .fcs.is-ph .fcs-p.is-open .fcs-body{display:grid}
