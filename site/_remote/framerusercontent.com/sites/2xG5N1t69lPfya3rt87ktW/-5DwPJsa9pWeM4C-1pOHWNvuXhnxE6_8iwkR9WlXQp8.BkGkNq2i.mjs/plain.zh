.fch{position:relative;isolation:isolate;overflow:hidden;background:var(--fc-night);color:var(--fc-cloud);--sc:0;--lx:0;--ly:0}
.fch-bg{position:absolute;inset:0;z-index:-1;pointer-events:none}
.fch-bg .g1{position:absolute;left:50%;top:50%;width:min(1100px,90vw);aspect-ratio:1/1;translate:-50% -50%;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--fc-brass) 18%,transparent) 0%,color-mix(in srgb,var(--fc-brass) 5%,transparent) 35%,color-mix(in srgb,var(--fc-brass) 0.4%,transparent) 65%);opacity:calc(1 - var(--sc)*.8)}
.fch-bg .g2{position:absolute;left:0;right:0;bottom:-30%;height:60%;background:radial-gradient(ellipse at 50% 100%,color-mix(in srgb,var(--fc-pine) 90%,transparent),color-mix(in srgb,var(--fc-pine) 0.4%,transparent) 70%)}
.fch-bg .grid{position:absolute;inset:0;background-image:linear-gradient(color-mix(in srgb,var(--fc-cloud) 5%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--fc-cloud) 5%,transparent) 1px,transparent 1px);background-size:80px 80px;mask-image:radial-gradient(ellipse at 50% 45%,#000 10%,transparent 70%);-webkit-mask-image:radial-gradient(ellipse at 50% 45%,#000 10%,transparent 70%)}
.fch-nav{position:relative;z-index:8;display:flex;align-items:center;gap:28px;max-width:calc(${st} + var(--g)*2);margin:0 auto;padding:20px var(--g) 0}
.fch-logo{display:flex;align-items:center;gap:9px;font-size:22px;letter-spacing:-.04em;color:var(--fc-cloud);text-decoration:none;line-height:1;font-weight:600} .fch-logo svg{fill:var(--fc-brass);animation:fcTw 3.2s ease-in-out infinite}
.fch-links{display:flex;gap:2px;list-style:none;margin:0 auto;padding:5px;border-radius:999px;background:color-mix(in srgb,var(--fc-cloud) 6%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-cloud) 12%,transparent);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)} .fch-links a{display:block;padding:9px 16px;border-radius:999px;color:color-mix(in srgb,var(--fc-cloud) 82%,transparent);text-decoration:none;font-size:14.5px;font-weight:500;transition:background .25s,color .25s} .fch-links a:hover{background:color-mix(in srgb,var(--fc-cloud) 10%,transparent);color:var(--fc-cloud)}
.fch-navcta{min-height:46px;font-size:14px}
.fch-stage{position:relative;max-width:calc(${st} + var(--g)*2);margin:0 auto;padding:0 var(--g);min-height:max(660px,calc(100svh - 86px));display:grid;grid-template-rows:auto 1fr auto}
.fch-top{position:relative;z-index:5;display:flex;flex-wrap:wrap;gap:10px;padding-top:clamp(26px,4vh,44px)}
.fch-live{display:inline-flex;align-items:center;gap:9px;margin:0;padding:8px 14px 8px 12px;border-radius:999px;background:color-mix(in srgb,var(--fc-brass) 12%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-brass) 30%,transparent);color:var(--fc-brass);font-size:12px;letter-spacing:.06em;text-transform:uppercase}
.fch-live i{width:7px;height:7px;border-radius:50%;background:var(--fc-brass);animation:fchPulse 1.8s ease-out infinite} @keyframes fchPulse{0%{box-shadow:0 0 0 0 color-mix(in srgb,var(--fc-brass) 60%,transparent)}100%{box-shadow:0 0 0 9px color-mix(in srgb,var(--fc-brass) 0.4%,transparent)}}
/* headline wraps around the orb: line 1 top-left, line 2 lower-right */
.fch-h{position:absolute;z-index:4;inset:0;margin:0;pointer-events:none;font-weight:inherit}
.fch-h .fc-hd{position:absolute;color:var(--fc-cloud);white-space:nowrap;translate:calc(var(--lx)*-14px) calc(var(--ly)*-8px - var(--sc)*80px);opacity:calc(1 - var(--sc)*.9)}
.fch-h1{left:var(--g);top:calc(86px + clamp(26px,4vh,44px) + clamp(48px,7vh,80px))} .fch-h2{right:var(--g);top:calc(86px + clamp(26px,4vh,44px) + clamp(48px,7vh,80px) + clamp(150px,24vh,260px))}
/* the orb */
.fch-orb{position:absolute;z-index:3;left:50%;top:50%;width:min(70vh,660px,60vw);aspect-ratio:1/1;translate:-50% -50%;border-radius:50%;cursor:pointer;transition:opacity 1.6s ease .3s;outline:none}
.fch-orb canvas{position:absolute;left:-15%;top:-15%;width:130%;height:130%;display:block}
.fch-orb:focus-visible{box-shadow:0 0 0 2px var(--fc-brass)}
.fch-halo{position:absolute;inset:-10%;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--fc-brass) 22%,transparent) 0%,color-mix(in srgb,var(--fc-brass) 7%,transparent) 30%,color-mix(in srgb,var(--fc-brass) 0.4%,transparent) 58%);pointer-events:none;z-index:-1}
.fch-shape{position:absolute;left:50%;bottom:-4%;translate:-50% 0;display:grid;justify-items:center;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent);white-space:nowrap} .fch-shape b{grid-area:1/1;font-weight:500;opacity:0;translate:0 6px;transition:opacity .5s,translate .5s} .fch-shape b.is-on{opacity:1;translate:0 0} .fch-shape b::before{content:"◆  ";color:var(--fc-brass)}
/* result chips orbit the core on an ellipse */
.fch-chips{position:absolute;z-index:5;inset:0;list-style:none;margin:0;padding:0;pointer-events:none}
.fch-chip{position:absolute;left:0;top:0;display:flex;align-items:center;gap:9px;padding:9px 14px 9px 10px;border-radius:999px;white-space:nowrap;background:color-mix(in srgb,var(--fc-night) 55%,transparent);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-cloud) 14%,transparent);font-size:13px;pointer-events:auto;animation:fchFloat 6s ease-in-out calc(var(--i)*-2s) infinite;transition:opacity 1s ease,box-shadow .5s,background .5s,scale .5s cubic-bezier(.34,1.56,.64,1)} .fch-chip:nth-child(1){left:var(--g);top:47%} .fch-chip:nth-child(2){left:calc(var(--g) + 60px);top:59%} .fch-chip:nth-child(3){right:var(--g);left:auto;top:37%} @keyframes fchFloat{0%,100%{translate:0 0}50%{translate:0 -10px}}
.fch-chip i{width:20px;height:20px;border-radius:50%;flex:none;background:color-mix(in srgb,var(--fc-brass) 18%,transparent);position:relative} .fch-chip i::after{content:"";position:absolute;left:7px;top:4px;width:5px;height:9px;border:solid var(--fc-brass);border-width:0 2px 2px 0;rotate:45deg}
.fch-chip b{font-weight:600} .fch-chip span{font-size:12px;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
.fch-chip.is-hot{background:color-mix(in srgb,var(--fc-brass) 18%,var(--fc-night));box-shadow:inset 0 0 0 1px var(--fc-brass),0 0 40px -6px color-mix(in srgb,var(--fc-brass) 60%,transparent);scale:1.06}
/* bottom band */
.fch-foot{position:relative;z-index:6;grid-row:3;pointer-events:none;display:flex;align-items:flex-end;justify-content:space-between;gap:40px;padding:0 0 clamp(28px,4.5vh,48px);translate:0 calc(var(--sc)*-40px)}
.fch-left{max-width:500px;pointer-events:auto} .fch-stats{pointer-events:auto} .fch-sub{margin:0;font-size:clamp(15.5px,1.1vw,17.5px);line-height:1.58;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
.fch-ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
.fch-stats{display:flex;gap:clamp(24px,3vw,48px);margin:0} .fch-stats div{display:flex;flex-direction:column;gap:6px;max-width:150px;padding-left:16px;border-left:1px solid color-mix(in srgb,var(--fc-cloud) 18%,transparent)} .fch-stats dt{white-space:nowrap;font-size:clamp(28px,2.4vw,40px);letter-spacing:-.04em;line-height:1;color:var(--fc-cloud)} .fch-stats dd{margin:0;font-size:12.5px;line-height:1.4;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
.fch .fc-btn.fc-solid{--face:var(--fc-brass);--edge:var(--fc-brass);--fill:var(--fc-cloud);--fg:var(--fc-ink);--fg2:var(--fc-ink);--chip:var(--fc-ink);--chipfg:var(--fc-brass);box-shadow:0 0 50px -10px color-mix(in srgb,var(--fc-brass) 70%,transparent);border-radius:999px}
/* cursor: a mint dot; over the core and the buttons it opens into a glass lens with a label */
.fch.has-cur,.fch.has-cur a,.fch.has-cur .fch-orb{cursor:none}
.fch-cur{position:absolute;z-index:20;left:0;top:0;width:12px;height:12px;margin:-6px 0 0 -6px;border-radius:50%;background:var(--fc-brass);box-shadow:0 0 18px var(--fc-brass);pointer-events:none;opacity:0;transition:opacity .3s,width .35s cubic-bezier(.2,.8,.2,1),height .35s cubic-bezier(.2,.8,.2,1),margin .35s cubic-bezier(.2,.8,.2,1),background .3s}
.fch-cur.is-lab{width:92px;height:92px;margin:-46px 0 0 -46px;background:color-mix(in srgb,var(--fc-cloud) 10%,transparent);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-brass) 70%,transparent)}
.fch-cur::after{content:attr(data-l);position:absolute;inset:0;display:grid;place-items:center;padding:0 10px;text-align:center;color:var(--fc-cloud);font:500 12px/1.25 var(--fc-font-m,'IBM Plex Mono'),monospace;letter-spacing:.12em;text-transform:uppercase;opacity:0;transition:opacity .2s} .fch-cur.is-lab::after{opacity:1}
.fch.no-nav .fch-stage{padding-top:86px}
/* tablet */
.fch.is-tab .fch-links a{padding:9px 10px;font-size:13.5px} .fch.is-tab .fch-nav{gap:12px}
.fch.is-tab .fch-stage{min-height:1080px} .fch.is-tab .fch-orb{top:46%;width:min(76vw,600px)} .fch.is-tab .fch-chip{font-size:12px} .fch.is-tab .fch-chip:nth-child(1){top:58%} .fch.is-tab .fch-chip:nth-child(2){top:64%;left:auto;right:32px} .fch.is-tab .fch-chip:nth-child(3){top:33%}
.fch.is-tab .fch-h1{top:176px} .fch.is-tab .fch-h2{top:268px}
.fch.is-tab .fch-foot{flex-direction:column;align-items:flex-start;gap:30px}
/* phone */
.fch.is-ph .fch-nav{padding:16px 18px 0;gap:12px;justify-content:space-between} .fch.is-ph .fch-navcta{min-height:42px;font-size:13px}
.fch.is-ph .fch-stage{min-height:0;display:flex;flex-direction:column;padding:0 20px}
.fch.is-ph .fch-h{position:relative;inset:auto;margin-top:22px;display:block} .fch.is-ph .fch-h .fc-hd{position:relative;left:auto;right:auto;top:auto;white-space:normal;display:block;translate:none}
.fch.is-ph .fch-orb{position:relative;left:auto;top:auto;translate:none;width:100%;margin:10px auto 18px}
.fch.is-ph .fch-foot{flex-direction:column;align-items:stretch;gap:28px;padding-top:12px;translate:none}
.fch.is-ph .fch-ctas{flex-direction:column;align-items:stretch} .fch.is-ph .fch-ctas .fc-btn{width:100%}
.fch.is-ph .fch-stats{flex-direction:column;gap:14px} .fch.is-ph .fch-stats div{max-width:none;flex-direction:row;align-items:baseline;gap:12px}
