.fcr{position:relative;overflow:hidden;background:var(--fc-night);color:var(--fc-cloud);padding:clamp(100px,11vw,170px) 0}
.fcr-q{position:absolute;right:4vw;top:-6vw;font-size:clamp(300px,38vw,640px);line-height:1;color:color-mix(in srgb,var(--fc-brass) 78%,transparent);pointer-events:none}
.fcr-grid{position:relative;display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(30px,5vw,90px);align-items:center}
.fcr-ph{position:relative;aspect-ratio:4/5;border-radius:28px;overflow:hidden;background:var(--fc-pine)}
.fcr-ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;clip-path:inset(100% 0 0 0);scale:1.15;transition:clip-path 1.1s cubic-bezier(.7,0,.2,1),scale 1.6s cubic-bezier(.2,.8,.2,1)} .fcr-ph img.is-on{clip-path:inset(0 0 0 0);scale:1;z-index:1}
.fcr-co{position:absolute;z-index:2;left:18px;bottom:18px;padding:8px 13px;border-radius:999px;background:color-mix(in srgb,var(--fc-night) 55%,transparent);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);font-size:12px;letter-spacing:.1em;text-transform:uppercase}
.fcr-tx{display:flex;flex-direction:column;gap:28px}
.fcr-quote{margin:0;font-size:clamp(28px,2.9vw,50px);line-height:1.12;letter-spacing:-.035em;font-weight:500;min-height:4.5em}
.fcr-w{display:inline-block;overflow:hidden;vertical-align:top;padding-bottom:.08em} .fcr-w>span{display:inline-block;animation:fcrUp .8s cubic-bezier(.2,.8,.2,1) both} @keyframes fcrUp{from{translate:0 105%}to{translate:0 0}}
.fcr-who{display:flex;flex-direction:column;gap:4px;margin:0} .fcr-who b{font-size:18px;font-weight:600} .fcr-who span{font-size:12px;letter-spacing:.06em;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
.fcr-nav{display:flex;align-items:center;gap:12px}
.fcr-btn{position:relative;display:grid;place-items:center;width:52px;height:52px;border:0;border-radius:50%;background:color-mix(in srgb,var(--fc-cloud) 8%,transparent);color:var(--fc-cloud);cursor:pointer;transition:background .3s,color .3s} .fcr-btn:hover{background:var(--fc-brass);color:var(--fc-ink)}
.fcr-ring{position:absolute;inset:0;width:100%;height:100%;rotate:-90deg} .fcr-ring circle{fill:none;stroke:var(--fc-brass);stroke-width:2;stroke-dasharray:151;stroke-dashoffset:151;animation:fcrRing var(--iv) linear forwards} .fcr.is-hold .fcr-ring circle{animation-play-state:paused} @keyframes fcrRing{to{stroke-dashoffset:0}}
.fcr-dots{display:flex;gap:4px;margin-left:10px} .fcr-dots button{width:24px;height:24px;padding:0;border:0;background:transparent;cursor:pointer;position:relative} .fcr-dots button::after{content:"";position:absolute;left:50%;top:50%;width:7px;height:7px;margin:-3.5px 0 0 -3.5px;border-radius:9px;background:color-mix(in srgb,var(--fc-cloud) 25%,transparent);transition:width .3s,margin .3s,background .3s} .fcr-dots button.is-on::after{width:20px;margin-left:-10px;background:var(--fc-brass)}
.fcr-num{margin-left:auto;font-size:12px;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
.fcr.is-ph .fcr-grid{grid-template-columns:1fr} .fcr.is-ph .fcr-ph{aspect-ratio:4/4.2} .fcr.is-ph .fcr-quote{font-size:26px;min-height:0} .fcr.is-ph .fcr-num{display:none}
