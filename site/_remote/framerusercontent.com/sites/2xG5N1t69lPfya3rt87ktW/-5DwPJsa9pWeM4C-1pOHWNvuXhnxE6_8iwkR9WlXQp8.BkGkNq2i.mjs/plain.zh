.fci{position:relative;z-index:11;height:calc(var(--n)*65vh + 100vh);background:var(--fc-bone);color:var(--fc-ink);--tear:1;margin-top:-5vw;
  clip-path:polygon(0 calc(5vw - 2vw*var(--tear)),7% calc(5vw - 4.6vw*var(--tear)),15% calc(5vw - .8vw*var(--tear)),24% calc(5vw - 3.9vw*var(--tear)),33% calc(5vw - 1.4vw*var(--tear)),41% calc(5vw - 5vw*var(--tear)),52% calc(5vw - 2.2vw*var(--tear)),60% calc(5vw - 4.1vw*var(--tear)),71% calc(5vw - .5vw*var(--tear)),80% calc(5vw - 3.4vw*var(--tear)),90% calc(5vw - 1.6vw*var(--tear)),100% calc(5vw - 4.4vw*var(--tear)),100% 100%,0 100%)}
.fci-stage{position:sticky;top:0;height:100vh;height:100svh;display:flex;align-items:center;overflow:hidden;padding-top:5vw}
.fci-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(30px,5vw,90px);align-items:center}
.fci-left{display:flex;flex-direction:column}
.fci-num{margin:clamp(20px,3vh,40px) 0 0;font-size:clamp(110px,12vw,220px);font-weight:500;letter-spacing:-.07em;line-height:.82;font-variant-numeric:tabular-nums;white-space:nowrap}
.fci-num span{display:inline-block;animation:fciUp .9s cubic-bezier(.2,.8,.2,1)} @keyframes fciUp{from{opacity:0;translate:0 30px;filter:blur(6px)}to{opacity:1;translate:0 0;filter:blur(0)}}
.fci-l{margin:18px 0 0;max-width:420px;font-size:clamp(18px,1.5vw,24px);line-height:1.35;letter-spacing:-.02em;animation:fciUp .8s cubic-bezier(.2,.8,.2,1) .1s both}
.fci-steps{display:flex;align-items:center;gap:6px;margin-top:clamp(24px,4vh,44px)} .fci-steps i{width:34px;height:4px;border-radius:9px;background:var(--fc-fog);transition:background .4s,width .4s} .fci-steps i.is-done{background:var(--fc-ink)} .fci-steps i.is-on{width:60px;background:var(--fc-brass)} .fci-steps span{margin-left:12px;font-size:12px;color:var(--fc-mut)}
.fci-note{margin:20px 0 0;max-width:320px;font-size:12px;line-height:1.6;color:var(--fc-mut)}
.fci-right{position:relative}
.fci-cut{position:relative;aspect-ratio:4/4.4;max-height:72vh;margin-left:auto;transition:clip-path 1.1s cubic-bezier(.7,0,.2,1);background:var(--fc-ink)}
.fci-cut img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;clip-path:inset(100% 0 0 0);scale:1.2;transition:clip-path 1.1s cubic-bezier(.7,0,.2,1),scale 1.6s cubic-bezier(.2,.8,.2,1)}
.fci-cut img.is-on{clip-path:inset(0 0 0 0);scale:1;z-index:2} .fci-cut img.is-past{clip-path:inset(0 0 0 0);z-index:1}
.fci-tag{position:absolute;z-index:3;left:-18px;top:14%;display:grid;place-items:center;width:64px;height:64px;border-radius:50%;background:var(--fc-brass);font-size:14px;font-weight:600;box-shadow:0 0 0 6px var(--fc-bone)}
.fci.is-still{height:auto} .fci.is-still .fci-stage{position:relative;height:auto;padding:140px 0 100px}
.fci.is-ph{height:calc(var(--n)*60vh + 100vh)} .fci.is-ph .fci-grid{grid-template-columns:1fr;gap:18px} .fci.is-ph .fci-right{order:-1} .fci.is-ph .fci-cut{aspect-ratio:16/11;max-height:34vh;width:100%} .fci.is-ph .fci-num{font-size:clamp(72px,21vw,110px);margin-top:14px} .fci.is-ph .fci-note{display:none} .fci.is-ph .fci-l{font-size:17px} .fci.is-ph .fci-tag{left:12px;top:12px;width:52px;height:52px}
