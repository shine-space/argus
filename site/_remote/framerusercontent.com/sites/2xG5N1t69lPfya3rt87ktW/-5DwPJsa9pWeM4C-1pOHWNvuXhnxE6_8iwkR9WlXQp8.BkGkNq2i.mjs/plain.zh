.fca.is-still{height:auto} .fca.is-still .fca-stage{position:relative;height:auto;min-height:900px}
.fca.is-ph{height:auto} .fca.is-ph .fca-stage{position:relative;height:auto;padding:100px 0 80px} .fca.is-ph .fca-top{flex-direction:column;align-items:flex-start}
.fca.is-ph .fca-sys{padding:40px 20px 0} .fca.is-ph .fca-core{position:relative;left:auto;top:auto;translate:none;margin:0 auto 40px;scale:1}
.fca.is-ph .fca-list{position:relative;display:flex;flex-wrap:wrap;gap:8px;justify-content:center} .fca.is-ph .fca-a{position:relative;left:auto;top:auto;margin:0;transform:none!important;opacity:1!important}
