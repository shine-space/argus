.fcz{position:relative;height:320vh;background:var(--fc-bone);--zt:0;--zo:0}
.fcz-stage{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden;isolation:isolate;background:var(--fc-night)}
.fcz-con{position:absolute;inset:0;display:flex;flex-direction:column;background:var(--fc-night);color:var(--fc-cloud);scale:calc(1.25 - var(--zt)*.25)}
.fcz-bar{display:flex;align-items:center;gap:7px;height:40px;padding:0 18px;background:color-mix(in srgb,var(--fc-pine) 80%,#000)} .fcz-bar i{width:10px;height:10px;border-radius:50%;background:color-mix(in srgb,var(--fc-cloud) 16%,transparent)} .fcz-bar i:first-child{background:var(--fc-brass)} .fcz-bar span{margin:0 auto;padding:3px 14px;border-radius:6px;background:color-mix(in srgb,var(--fc-cloud) 7%,transparent);font-size:12px;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
.fcz-app{flex:1;display:grid;grid-template-columns:1fr 1.8fr .9fr;gap:1px;background:color-mix(in srgb,var(--fc-cloud) 8%,transparent);min-height:0}
.fcz-app>*{background:var(--fc-night);padding:clamp(18px,2vw,30px);overflow:hidden}
.fcz-h{display:flex;align-items:center;justify-content:space-between;margin:0 0 14px;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
.fcz-live{display:inline-flex;align-items:center;gap:6px;color:var(--fc-brass)} .fcz-live i{width:6px;height:6px;border-radius:50%;background:var(--fc-brass);animation:fcLed 1.2s ease-in-out infinite}
.fcz-ag{display:flex;align-items:center;gap:10px;padding:12px;border-radius:14px;margin-bottom:8px;background:color-mix(in srgb,var(--fc-cloud) 4%,transparent)} .fcz-ag>i{width:8px;height:8px;border-radius:50%;flex:none;background:var(--fc-brass);box-shadow:0 0 8px var(--fc-brass)} .fcz-ag.s-running>i{animation:fcLed 1s ease-in-out infinite} .fcz-ag.s-scheduled>i{background:color-mix(in srgb,var(--fc-cloud) 35%,transparent);box-shadow:none}
.fcz-ag span{display:flex;flex-direction:column;gap:3px;min-width:0} .fcz-ag b{font-size:14px;font-weight:600} .fcz-ag em{font-style:normal;font-size:12px;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent);white-space:nowrap;overflow:hidden;text-overflow:ellipsis} .fcz-ag small{margin-left:auto;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--fc-brass)}
.fcz-feed ol{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
.fcz-feed li{display:flex;align-items:center;gap:14px;padding:12px 14px;border-radius:12px;background:color-mix(in srgb,var(--fc-cloud) 4%,transparent);font-size:14px;animation:fczIn .6s cubic-bezier(.2,.8,.2,1)} .fcz-feed li.is-new{background:color-mix(in srgb,var(--fc-brass) 12%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-brass) 40%,transparent)}
@keyframes fczIn{from{opacity:0;translate:0 -14px}to{opacity:1;translate:0 0}}
.fcz-feed time{font-size:12px;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)} .fcz-feed span{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis} .fcz-feed li b{font-size:12px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--fc-brass)}
.fcz-kpi{display:flex;flex-direction:column;gap:12px} .fcz-kpi div{display:flex;flex-direction:column;gap:5px;padding:16px;border-radius:14px;background:color-mix(in srgb,var(--fc-cloud) 4%,transparent)} .fcz-kpi b{font-size:34px;font-weight:500;letter-spacing:-.04em;line-height:1} .fcz-kpi span{font-size:12px;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)} .fcz-kpi svg{width:100%;height:26px;margin-top:4px} .fcz-kpi path{fill:none;stroke:var(--fc-brass);stroke-width:2;vector-effect:non-scaling-stroke}
.fcz-note{position:absolute;z-index:3;display:flex;align-items:center;gap:8px;margin:0;padding:11px 15px;border-radius:999px;background:var(--fc-cloud);color:var(--fc-ink);font-size:12.5px;box-shadow:0 18px 40px -16px #000;white-space:nowrap;opacity:var(--zo);scale:calc(.8 + var(--zo)*.2)} .fcz-note i{width:8px;height:8px;border-radius:50%;background:var(--fc-brass)}
.fcz-note.n0{left:22%;top:18%} .fcz-note.n1{right:6%;top:52%} .fcz-note.n2{left:34%;bottom:10%}
/* the paper mask: until the canvas has drawn, a plain white sheet with the headline in ink; then the canvas (white with the letters cut out) takes over and the DOM text only keeps the layout */
.fcz-cv{position:absolute;inset:0;z-index:2;width:100%;height:100%;pointer-events:none;opacity:calc(1 - max(0,(var(--zt) - .9)*10))}
.fcz-mask{position:absolute;inset:0;z-index:3;display:flex;flex-direction:column;justify-content:center;padding:0 var(--g);background:#fff;color:#000;pointer-events:none}
.fcz-mask.is-cv{background:transparent} .fcz-mask.is-cv .fcz-h2{color:transparent}
.fcz-eb{margin:0 0 18px;font-size:12px;letter-spacing:.16em;text-transform:uppercase;opacity:calc(1 - var(--zt)*20)}
.fcz-h2{margin:0;display:flex;flex-direction:column;font-weight:700;letter-spacing:-.06em;line-height:.84;color:#000}
.fcz-l2{align-self:flex-end} .fcz-t{display:inline-block}
.fcz-body{margin:26px 0 0;max-width:420px;font-size:17px;line-height:1.55;color:color-mix(in srgb,#000 64%,#fff);opacity:calc(1 - var(--zt)*20)}
.fcz-cue{position:absolute;left:50%;bottom:28px;translate:-50% 0;display:flex;align-items:center;gap:10px;margin:0;font-size:12px;letter-spacing:.16em;text-transform:uppercase;opacity:calc(.6 - var(--zt)*5)} .fcz-cue i{width:1px;height:28px;background:#000;animation:fczCue 1.6s ease-in-out infinite} @keyframes fczCue{0%,100%{transform:scaleY(.3);transform-origin:0 0}50%{transform:scaleY(1)}}
.fcz.is-still{height:auto} .fcz.is-still .fcz-stage{position:relative;height:auto} .fcz.is-still .fcz-mask,.fcz.is-still .fcz-cv{display:none} .fcz.is-still .fcz-con{position:relative;min-height:700px;scale:1} .fcz.is-still .fcz-note{opacity:1}
