.f404{position:relative;overflow:hidden;min-height:100svh;display:flex;align-items:center;background:var(--fc-night);color:var(--fc-cloud);padding:140px 0 90px}
.f404-in{display:flex;flex-direction:column;align-items:center;text-align:center}
.f404-big{display:flex;align-items:center;gap:.08em;margin:0;font-size:clamp(160px,24vw,380px);font-weight:600;letter-spacing:-.07em;line-height:.8}
.f404-core{position:relative;display:inline-block;width:.72em;height:.72em;margin:0 .06em;--r:calc(clamp(160px,24vw,380px)*.36 + 26px)}
.f404-core b{position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 38% 34%,color-mix(in srgb,var(--fc-brass) 85%,#fff),var(--fc-brass) 28%,color-mix(in srgb,var(--fc-brass) 30%,var(--fc-night)) 68%);box-shadow:0 0 120px 20px color-mix(in srgb,var(--fc-brass) 30%,transparent);animation:f404P 3s ease-in-out infinite} @keyframes f404P{0%,100%{scale:1}50%{scale:.94}}
.f404-core i{position:absolute;inset:-18%;border-radius:50%;border:1px dashed color-mix(in srgb,var(--fc-brass) 45%,transparent);animation:fcSpin 30s linear infinite}
.f404-core em{position:absolute;left:50%;top:50%;width:0;height:0;rotate:var(--a);animation:f404O 22s linear infinite} .f404-core em span{position:absolute;left:0;top:0;translate:-50% calc(-50% - var(--r));display:inline-block;padding:6px 10px;border-radius:999px;background:color-mix(in srgb,var(--fc-pine) 90%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-cloud) 16%,transparent);font-size:12px;font-weight:500;letter-spacing:.02em;white-space:nowrap;rotate:calc(var(--a)*-1);animation:f404C 22s linear infinite}
@keyframes f404O{to{rotate:calc(var(--a) + 360deg)}} @keyframes f404C{to{rotate:calc(var(--a)*-1 - 360deg)}}
.f404 h1{margin:40px 0 0;font-size:clamp(32px,3.2vw,54px);font-weight:500;letter-spacing:-.045em}
.f404-sub{margin:16px 0 0;max-width:480px;font-size:17px;line-height:1.6;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
.f404-links{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;list-style:none;margin:30px 0 34px;padding:0} .f404-links a{display:inline-flex;align-items:center;gap:8px;padding:12px 18px;border-radius:999px;background:color-mix(in srgb,var(--fc-cloud) 8%,transparent);color:var(--fc-cloud);text-decoration:none;font-size:14px;transition:background .3s,color .3s} .f404-links a:hover{background:var(--fc-brass);color:var(--fc-ink)}
.f404 .fc-btn.fc-solid{--face:var(--fc-brass);--edge:var(--fc-brass);--fill:var(--fc-cloud);--fg:var(--fc-ink);--fg2:var(--fc-ink);--chip:var(--fc-ink);--chipfg:var(--fc-brass)}
