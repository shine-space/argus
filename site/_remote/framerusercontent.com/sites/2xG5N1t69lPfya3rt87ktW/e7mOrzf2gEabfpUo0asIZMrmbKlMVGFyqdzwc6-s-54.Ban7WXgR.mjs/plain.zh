.fc[data-kb] *,.fc[data-kb] *::before,.fc[data-kb] *::after{transition:none!important}
.fc-sec{position:relative;z-index:10;display:block;width:100%;--sp:.5;--pp:0}
.fc-rev{position:relative;width:100%;--rv:1} .fc-rev-in{position:relative} .fc-rev-sp{height:0}
.fc-rev.is-act{--rv:0;--t:min(var(--h),100vh);--t:min(var(--h),100svh);z-index:var(--layer,9);margin-top:calc(var(--t)*-1)}
.fc-rev.is-act>.fc-rev-in{position:sticky;top:calc(100vh - var(--t));top:calc(100svh - var(--t))} .fc-rev.is-act>.fc-rev-sp{height:var(--t)}
/* the lifting edge throws a shadow on the section beneath, and that section comes out of the dark as it is uncovered */
.fc-rev.is-act>.fc-rev-in::before{content:"";position:absolute;z-index:40;left:0;right:0;top:0;height:120px;translate:0 calc((1 - var(--rv))*var(--t));background:linear-gradient(180deg,rgba(0,0,0,.2),rgba(0,0,0,0));opacity:min(1,calc(var(--rv)*(1 - var(--rv))*9));pointer-events:none}
.fc-rev.is-act>.fc-rev-in::after{content:"";position:absolute;z-index:39;left:0;right:0;top:0;height:var(--t);background:#000;opacity:calc((1 - var(--rv))*.16);pointer-events:none}
.fc-wrap{--pad:56px;width:100%;max-width:calc(${N} + var(--pad)*2);margin:0 auto;padding-left:var(--pad);padding-right:var(--pad)}
.fc-eb{display:inline-flex;align-items:center;gap:10px;width:max-content;max-width:100%;margin:0;padding:7px 14px 7px 8px;border-radius:999px;background:var(--fc-cloud);color:var(--fc-ink);box-shadow:inset 0 0 0 1px var(--fc-fog)!important;font-size:12px;letter-spacing:.1em;text-transform:uppercase;line-height:1.2;opacity:0;translate:0 10px;transition:opacity .7s ease,translate .8s cubic-bezier(.2,.8,.2,1);box-shadow:inset 0 1px 0 color-mix(in srgb,#fff 12%,transparent)} .fc-eb.is-on{opacity:1;translate:0 0}
.fc-eb i{position:relative;width:18px;height:18px;display:block;flex:none;border-radius:50%;background:var(--fc-brass)} .fc-eb i::after{content:"";position:absolute;inset:5px;border-radius:50%;border:2px solid var(--fc-ink);border-right-color:transparent;animation:fcSpin 1.2s linear infinite} @keyframes fcSpin{to{rotate:360deg}} @keyframes fcLed{0%,100%{opacity:1}50%{opacity:.35}}
.fc-dark .fc-eb{background:color-mix(in srgb,var(--fc-cloud) 8%,transparent);color:var(--fc-cloud);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-cloud) 16%,transparent)!important}
.fc-hd{margin:0;letter-spacing:-.045em;text-wrap:balance} .fc-hd-l{display:block}
.fc-hd-w{display:inline-block;overflow:hidden;vertical-align:top;padding:0 .05em .17em;margin:0 -.05em -.17em;white-space:pre}
.fc-hd-i{position:relative;display:inline-block;translate:0 108%;transition:translate 1s cubic-bezier(.2,.75,.2,1)}
.fc-hd.is-on .fc-hd-i{translate:0 0}
.fc-hd-w.is-accw{overflow:visible;clip-path:inset(-.6em -.6em .02em -.2em)}
.fc-it{position:relative;padding-right:.36em;background:linear-gradient(100deg,var(--fc-brass) 10%,color-mix(in srgb,var(--fc-brass) 35%,var(--fc-cloud)) 90%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent} :where(.fc:not(.fc-dark)) .fc-it{background:linear-gradient(100deg,var(--fc-ink) 10%,color-mix(in srgb,var(--fc-brass) 55%,var(--fc-ink)) 90%);-webkit-background-clip:text;background-clip:text}
.fc-spark{position:absolute;right:-.02em;top:.02em;width:.34em;height:.34em;overflow:visible;fill:var(--fc-brass);scale:0;rotate:-90deg;transition:scale .7s cubic-bezier(.34,1.56,.64,1) var(--pd,0ms),rotate .9s cubic-bezier(.2,.8,.2,1) var(--pd,0ms)}
.fc-hd.is-on .fc-spark{scale:1;rotate:0deg;animation:fcTw 3.2s ease-in-out calc(var(--pd,0ms) + 900ms) infinite} @keyframes fcTw{0%,100%{opacity:1;scale:1}50%{opacity:.55;scale:.72}}
.fc-um{position:relative;overflow:hidden;transition:clip-path 1.35s cubic-bezier(.7,0,.2,1);background:color-mix(in srgb,var(--fc-stone) 22%,transparent)}
.fc-um img{position:absolute;left:0;top:-9%;width:100%;height:118%;display:block;object-fit:cover;scale:1.28;translate:0 calc((var(--sp,.5) - .5)*var(--par,1)*-7%);transition:scale 1.9s cubic-bezier(.16,.84,.24,1);user-select:none}
.fc-um.is-on img{scale:1}
/* diagonal cuts: the section hangs over its neighbour and is cut on a slope (clip-path, so the neighbour shows through) */
.fc-cut-t{margin-top:calc(var(--cut,7vw)*-1);clip-path:polygon(0 var(--cut,7vw),100% 0,100% 100%,0 100%);padding-top:var(--cut,7vw)}
.fc-cut-b{margin-bottom:calc(var(--cut,7vw)*-1);padding-bottom:var(--cut,7vw)}
.fc-cut-t.fc-cut-b{clip-path:polygon(0 var(--cut,7vw),100% 0,100% calc(100% - var(--cut,7vw)),0 100%)}
.fc-cut-b:not(.fc-cut-t){clip-path:polygon(0 0,100% 0,100% calc(100% - var(--cut,7vw)),0 100%)}
@media (max-width:1099px){.fc-wrap{--pad:32px}}
@media (max-width:699px){.fc-wrap{--pad:20px}}
:root{--g:56px}@media (max-width:1099px){:root{--g:32px}}@media (max-width:699px){:root{--g:20px}}
@media (prefers-reduced-motion:reduce){.fc-hd-i{translate:0 0!important} .fc-spark{scale:1!important;rotate:0deg!important;animation:none!important} .fc-um{clip-path:none!important} .fc-um img{scale:1!important;translate:0 0!important}}
`,U={site:[{slug:`site`,f1:`argus`,f2:"AI 自动化工作室",f3:"为团队打造日常使用的 AI 智能体与自动化流程，覆盖客服、销售运营和后台事务，数周即可上线。",f4:`hello@argus.ai`,f5:`+1 646 555 0187`,f6:"纽约",f7:`America/New_York`,f8:`/book`,f9:`X:https://x.com, LinkedIn:https://linkedin.com, YouTube:https://youtube.com`,f10:"第四季度项目预约中 · 剩余 3 个名额",f11:"美国纽约市西 21 街 54 号，邮编 10010",f12:"周一至周五 09:00–18:00（美国东部时间）",f13:`1-5 09:00-18:00`,n1:`1`}],plans:[{slug:`audit`,f1:"自动化评估",f2:`$1,500`,f3:`one-off`,f4:"找出值得自动化的耗时工作",f5:"与你的团队进行两天流程评估;按投资回报排序的自动化清单;架构与工具方案;开发固定报价",f6:``,f7:"预约评估",n1:`1`},{slug:`build`,f1:"智能体开发",f2:`$8,500`,f3:"起 / 每个智能体",f4:"一个智能体或一条工作流，数周即可上线",f5:"包含评估计划的全部内容;设计、开发与测试;与你现有工具集成;团队培训与交接;上线后提供 30 天调优",f6:`yes`,f7:"启动开发",n1:`2`},{slug:`partner`,f1:"AI 长期合作计划",f2:`$3,900`,f3:`per month`,f4:"每月都有 AI 团队随时支持",f5:"每月新增自动化流程;运行监控与月度报告;Slack 优先支持;季度策略研讨",f6:``,f7:"联系我们",n1:`3`}],services:[{slug:`voice-agents`,f1:"语音智能体",f2:"日夜在线的 AI 接待员，以自然语音接听每一通来电、安排预约并筛选意向客户。",f3:`0 missed`,f4:"非工作时间来电",f5:`voice`,f6:`Twilio, Vapi, Google Calendar, HubSpot`,f7:"围绕你的价格、政策和日历配置。来电者提出要求时，立即转交人工。",f8:"听取 50 通真实来电，梳理来电者的问题;制定语音风格、规则和人工接管条件;连接日历、CRM 和电话线路;与你的团队并行试运行一周",f9:"符合品牌风格的自然语音;预约、改约与确认;解答价格、营业时间和政策问题;按需转接人工;通话录音与摘要同步到 CRM",f10:`$8,500`,n1:`1`},{slug:`workflow-automation`,f1:"工作流自动化",f2:"工具之间的复制粘贴交给智能体：发票入账、CRM 更新、报告发送，自动完成。",f3:`31 h`,f4:"每人每月节省时间",f5:`workflow`,f6:`Make, n8n, Zapier, Xero, Slack`,f7:"先梳理流程，再自动化其中的重复步骤，需要判断的环节继续由人工负责。",f8:"跟进实际流程，记录每一步耗时;确定智能体负责什么、哪些环节由人工审批;构建工作流，加入日志与告警;提供操作手册与培训，完成交付",f9:"读取邮件、PDF 与表单;在你的工具之间流转数据;需要判断的环节由人工审批;出现异常时通过 Slack 告警;每月节省工时报告",f10:`$6,500`,n1:`2`},{slug:`support-agents`,f1:"客服智能体",f2:"根据文档和订单数据回答问题，能直接解决问题的聊天与邮件客服智能体。",f3:`68%`,f4:"无需人工解决的工单",f5:`support`,f6:`Zendesk, Intercom, Shopify, Gorgias`,f7:"每个回答都引用来源页面。不确定的问题会附上回复草稿交给你的团队。",f8:"阅读 500 张历史工单，按意图分类;连接客服系统、店铺和文档;编写答案与升级人工规则;先上线一个渠道，再逐步扩展",f9:"接入客服系统的聊天和邮件渠道;订单查询、退货与物流追踪;根据你的文档回答并引用来源;升级人工时附上回复草稿;每周准确率复盘",f10:`$9,500`,n1:`3`},{slug:`knowledge-base`,f1:"AI 知识库",f2:"一个搜索框，覆盖云盘、知识库和邮箱，用通俗语言回答，并附带来源。",f3:`9 s`,f4:"找到答案",f5:`knowledge`,f6:`Notion, Google Drive, Confluence, Slack`,f7:"公司专属，遵循现有访问权限，并随文件变化自动更新。",f8:"列出数据来源和访问权限;按权限索引云盘、知识库与邮箱;用 100 个真实问题测试答案;在 Slack 或 Teams 中发布",f9:"检索云盘、知识库与邮件;回答附带来源及页码;遵循现有访问权限;随文件变化保持同步;使用情况与知识缺口报告",f10:`$7,500`,n1:`4`},{slug:`custom-ai-apps`,f1:"定制 AI 应用",f2:"围绕模型打造内部工具：提案撰写、报价生成、线索评分。",f3:`4 wks`,f4:"从想法到工具上线",f5:`apps`,f6:`OpenAI, Anthropic, Supabase, Retool`,f7:"精巧实用的工具，让团队每天都愿意打开，并配备运营负责人所需的约束机制和日志。",f8:"找出最值得开发工具的那项任务;一周内与你的团队完成原型;开发时配置约束机制与日志;上线、培训并衡量成效",f9:"专注解决问题的内部工具;根据任务选用最合适的模型;访问控制与审计日志;由我们托管和维护;每月持续迭代",f10:`$12,000`,n1:`5`}]},W=`FcBook@cms1`,Oe=a===void 0?h:r,ke=`1–10, 11–50, 51–200, 200+`,Ae=`09:30, 11:00, 13:30, 15:00, 16:30`,je=`
.fcbk{position:relative;background:var(--fc-bone);color:var(--fc-ink);padding:clamp(150px,18vh,200px) 0 clamp(90px,10vw,150px)}
.fcbk-sub{margin:22px 0 0;max-width:560px;font-size:18px;line-height:1.6;color:var(--fc-mut)}
.fcbk-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:clamp(16px,2vw,28px);margin-top:clamp(40px,5vw,70px);align-items:start}
.fcbk-main{padding:clamp(22px,3vw,44px);border-radius:34px;background:var(--fc-cloud);box-shadow:inset 0 0 0 1px var(--fc-fog)}
.fcbk-steps{display:flex;gap:6px;list-style:none;margin:0 0 30px;padding:0} .fcbk-steps li{flex:1} .fcbk-steps button{display:flex;align-items:center;gap:8px;width:100%;padding:12px 14px;border:0;border-radius:14px;background:var(--fc-bone);color:var(--fc-mut);font:inherit;font-size:12px;letter-spacing:.06em;cursor:pointer;text-align:left} .fcbk-steps button:disabled{cursor:default} .fcbk-steps em{font-style:normal;font-size:12px}
.fcbk-steps li.is-cur button{background:var(--fc-ink);color:var(--fc-cloud)} .fcbk-steps li.is-cur em{color:var(--fc-brass)} .fcbk-steps li.is-done button{background:color-mix(in srgb,var(--fc-brass) 40%,var(--fc-cloud));color:var(--fc-ink)}
.fcbk-box{animation:fcbkIn .5s cubic-bezier(.2,.8,.2,1)} @keyframes fcbkIn{from{opacity:0;translate:24px 0}to{opacity:1;translate:0 0}}
.fcbk-q{margin:0 0 20px;font-size:clamp(26px,2.2vw,36px);font-weight:500;letter-spacing:-.04em} .fcbk-q2{margin:26px 0 12px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--fc-mut)}
.fcbk-opts{display:grid;grid-template-columns:1fr 1fr;gap:8px} .fcbk-opts button,.fcbk-plans button{display:flex;flex-direction:column;align-items:flex-start;gap:4px;padding:16px;border:0;border-radius:18px;background:var(--fc-bone);color:var(--fc-ink);font:inherit;text-align:left;cursor:pointer;box-shadow:inset 0 0 0 1.5px transparent;transition:background .3s,box-shadow .3s} .fcbk-opts b,.fcbk-plans b{font-size:16px;font-weight:600} .fcbk-opts span,.fcbk-plans span{font-size:12px;color:var(--fc-mut)}
.fcbk-opts button.is-on,.fcbk-plans button.is-on{background:color-mix(in srgb,var(--fc-brass) 26%,var(--fc-cloud));box-shadow:inset 0 0 0 1.5px var(--fc-ink)}
.fcbk-plans{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.fcbk-sizes{display:grid;grid-template-columns:repeat(4,1fr);gap:8px} .fcbk-sizes button{display:flex;flex-direction:column;align-items:flex-start;gap:4px;padding:20px 16px;border:0;border-radius:18px;background:var(--fc-bone);color:var(--fc-ink);font-size:26px;font-weight:500;letter-spacing:-.03em;cursor:pointer} .fcbk-sizes em{font-style:normal;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--fc-mut)} .fcbk-sizes button.is-on{background:var(--fc-ink);color:var(--fc-cloud)} .fcbk-sizes button.is-on em{color:var(--fc-brass)}
.fcbk-range{display:grid;grid-template-columns:1fr auto;align-items:end;gap:10px;margin-top:30px} .fcbk-range span{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--fc-mut)} .fcbk-range b{font-size:44px;font-weight:500;letter-spacing:-.05em;line-height:1}
.fcbk-range input{grid-column:1/-1;-webkit-appearance:none;appearance:none;width:100%;height:8px;border-radius:9px;background:linear-gradient(90deg,var(--fc-brass) var(--p),var(--fc-fog) var(--p));outline:none;cursor:pointer} .fcbk-range input::-webkit-slider-thumb{-webkit-appearance:none;width:30px;height:30px;border-radius:50%;background:var(--fc-ink);box-shadow:0 0 0 6px color-mix(in srgb,var(--fc-brass) 40%,transparent)} .fcbk-range input::-moz-range-thumb{width:30px;height:30px;border:0;border-radius:50%;background:var(--fc-ink)} .fcbk-range input:focus-visible{outline:3px solid var(--fc-ink);outline-offset:6px}
.fcbk-cost{margin:22px 0 0;font-size:15px;color:var(--fc-mut)} .fcbk-cost b{font-size:28px;font-weight:500;letter-spacing:-.04em;color:var(--fc-ink)}
.fcbk-days{display:grid;grid-template-columns:repeat(5,1fr);gap:8px} .fcbk-days button{display:flex;flex-direction:column;align-items:flex-start;gap:4px;padding:14px;border:0;border-radius:16px;background:var(--fc-bone);color:var(--fc-ink);font:inherit;cursor:pointer} .fcbk-days em{font-style:normal;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--fc-mut)} .fcbk-days b{font-size:18px;font-weight:500;letter-spacing:-.02em} .fcbk-days button.is-on{background:var(--fc-ink);color:var(--fc-cloud)} .fcbk-days button.is-on em{color:var(--fc-brass)}
.fcbk-slots{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px} .fcbk-slots button{padding:12px 18px;border:0;border-radius:999px;background:var(--fc-bone);color:var(--fc-ink);font:inherit;font-size:14px;cursor:pointer} .fcbk-slots button:disabled{opacity:.4;cursor:not-allowed} .fcbk-slots button.is-on{background:var(--fc-brass)}
.fcbk-tz{margin:14px 0 0;font-size:12px;color:var(--fc-mut)}
.fcbk-fields{display:grid;grid-template-columns:1fr 1fr;gap:10px} .fcbk-f{display:flex;flex-direction:column;gap:6px;padding:14px 16px 10px;border-radius:18px;background:var(--fc-bone)} .fcbk-f{transition:background .25s,box-shadow .25s} .fcbk-f:focus-within{background:var(--fc-cloud);box-shadow:inset 0 0 0 1.5px var(--fc-ink),0 0 0 4px color-mix(in srgb,var(--fc-brass) 30%,transparent)} .fcbk-f.is-area{grid-column:1/-1} .fcbk-f span{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--fc-mut)} .fcbk-f input,.fcbk-f textarea{border:0;background:transparent;font:inherit;font-size:16px;color:var(--fc-ink);outline:none;resize:none}
.fcbk-err{margin:18px 0 0;padding:12px 16px;border-radius:14px;background:color-mix(in srgb,#D93A2B 10%,var(--fc-cloud));color:#A6261A;font-size:14px}
.fcbk-nav{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:28px} .fcbk-back{padding:14px 18px;border:0;border-radius:999px;background:var(--fc-bone);color:var(--fc-ink);font:inherit;font-size:12px;letter-spacing:.1em;text-transform:uppercase;cursor:pointer}
.fcbk-next{display:flex;align-items:center;gap:16px;margin-left:auto;height:58px;padding:0 8px 0 24px;border:0;border-radius:999px;background:var(--fc-ink);color:var(--fc-cloud);font:inherit;font-size:16px;font-weight:600;cursor:pointer} .fcbk-next i{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:var(--fc-brass);color:var(--fc-ink);transition:rotate .4s} .fcbk-next:hover i{rotate:-45deg}
.fcbk-sum{position:sticky;top:110px;display:flex;flex-direction:column;gap:16px;padding:clamp(22px,2.4vw,34px);border-radius:34px;background:var(--fc-night);color:var(--fc-cloud)} .fcbk-sum>p{margin:0;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--fc-brass)}
.fcbk-sum dl{margin:0;display:flex;flex-direction:column} .fcbk-sum dl div{display:flex;justify-content:space-between;gap:16px;padding:14px 0;border-bottom:1px solid color-mix(in srgb,var(--fc-cloud) 10%,transparent)} .fcbk-sum dt{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)} .fcbk-sum dd{margin:0;text-align:right;font-size:14px}
.fcbk-big{display:flex;flex-direction:column;gap:4px;margin:10px 0 0} .fcbk-big b{font-size:clamp(40px,3.8vw,64px);font-weight:500;letter-spacing:-.05em;line-height:1;color:var(--fc-brass)} .fcbk-big span{font-size:13px;color:color-mix(in srgb,var(--fc-cloud) 78%,transparent)}
.fcbk-done{display:flex;flex-direction:column;gap:14px;padding:30px 0} .fcbk-done>span{display:grid;place-items:center;width:70px;height:70px;border-radius:50%;background:var(--fc-brass);animation:fcbkIn .6s} .fcbk-done h2{margin:0;font-size:44px;font-weight:500;letter-spacing:-.04em} .fcbk-done p{margin:0;color:var(--fc-mut)}
@media (max-width:1099px){.fcbk-grid{grid-template-columns:1fr} .fcbk-sum{position:relative;top:auto}}
.fcbk.is-ph .fcbk-opts,.fcbk.is-ph .fcbk-fields,.fcbk.is-ph .fcbk-plans{grid-template-columns:1fr} .fcbk.is-ph .fcbk-sizes{grid-template-columns:1fr 1fr} .fcbk.is-ph .fcbk-days{grid-template-columns:repeat(3,1fr)} .fcbk.is-ph .fcbk-steps button{padding:10px 8px;font-size:12px;flex-direction:column;align-items:flex-start;gap:2px}`,O(j,{heading:{type:w.String,title:`Heading`,displayTextArea:!0,defaultValue:"预约免费|*自动化评估。*",description:`| = line break, *word* = mint gradient`},sub:{type:w.String,title:`Sub Copy`,displayTextArea:!0,defaultValue:"与未来负责项目的人交流 20 分钟，带走三项最值得优先开展的自动化建议。"},stepNames:{type:w.String,title:`Step Names`,defaultValue:`Scope, Team, Time, Details`,description:`4, comma separated`},sizes:{type:w.String,title:`Team Sizes`,defaultValue:ke,description:`comma separated`},slots:{type:w.String,title:`Time Slots`,defaultValue:Ae,description:`comma separated, in the Site time zone`},rate:{type:w.Number,title:`Hourly Cost`,defaultValue:45,min:1,max:1e3,step:1,description:`Used for the yearly cost estimate`},currency:{type:w.String,title:`Currency`,defaultValue:`$`},summaryTitle:{type:w.String,title:`Summary Title`,defaultValue:"预约沟通"},costLabel:{type:w.String,title:`Cost Label`,defaultValue:"每年用于重复工作的费用"},nextLabel:{type:w.String,title:`Next Label`,defaultValue:"继续"},backLabel:{type:w.String,title:`Back Label`,defaultValue:"返回"},button:{type:w.String,title:`Confirm Label`,defaultValue:"确认预约"},doneTitle:{type:w.String,title:`Done Title`,defaultValue:"预约成功。"},doneText:{type:w.String,title:`Done Text`,defaultValue:"日历邀请即将发送。你的预约编号是"},endpoint:{type:w.String,title:`Endpoint`,defaultValue:``,description:`Optional URL that receives the booking as JSON`},...V,...z,...B})})),Me,K,q,J,Y,X,Z,Q,Ne,$,Pe;e((()=>{p(),v(),te(),m(),G(),A(),Me=_(j),K={b6I47V3sg:`(min-width: 1200px)`,qU9WQvBMH:`(min-width: 810px) and (max-width: 1199.98px)`,r7wDdST1r:`(max-width: 809.98px)`},q=[],J=`framer-MOmdJ`,Y={b6I47V3sg:`framer-v-1up3kf2`,qU9WQvBMH:`framer-v-1rcq9e1`,r7wDdST1r:`framer-v-1