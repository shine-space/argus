:where(.fc){position:relative;z-index:10} .fc,.fc *{box-sizing:border-box;min-width:0} .fc-sr{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip:rect(0 0 0 0)!important;white-space:nowrap!important;padding:0!important;margin:-1px!important;border:0!important} :where(.fc) a{color:inherit} html,body{overflow-x:clip}
:where(a[href],button,input,select,textarea,summary,[tabindex]:not([tabindex="-1"]),[role="button"]):focus-visible{outline:3px solid var(--fc-ink,#1D1830)!important;outline-offset:2px!important;box-shadow:0 0 0 2px var(--fc-bone,#EDE3D1)!important} :where(.fc-dark) :where(a[href],button,input,select,textarea,summary,[tabindex]:not([tabindex="-1"])):focus-visible{outline-color:var(--fc-cloud,#FFFFFF)!important;box-shadow:0 0 0 2px var(--fc-night,#0F1113)!important} :where(.fc-inring) :where(a[href],button):focus-visible{outline-offset:-4px!important;box-shadow:none!important} :where(.fc) :is(input:not([type=range]):not([type=checkbox]):not([type=radio]),textarea,select):focus-visible{outline:none!important;box-shadow:none!important} :where(.fc) textarea{resize:none} .fc-inring:focus-visible{outline-offset:-3px!important;box-shadow:none!important} html{scroll-padding-top:96px;scroll-padding-bottom:88px}
.fc-btn{position:relative;display:inline-flex;padding:0;min-height:54px;border-radius:999px;text-decoration:none;cursor:pointer;isolation:isolate;white-space:nowrap;font-size:14.5px;font-weight:600;letter-spacing:.005em;border:0;color:var(--fg);transition:transform .5s cubic-bezier(.2,.8,.2,1)}
.fc-cap{position:relative;display:inline-flex;align-items:center;gap:14px;width:100%;min-height:inherit;padding:0 7px 0 24px;border-radius:inherit;background:var(--face);overflow:hidden;box-shadow:inset 0 0 0 1.5px var(--edge);isolation:isolate}
.fc-cap::before{content:"";position:absolute;z-index:-1;inset:0;border-radius:inherit;background:var(--fill);clip-path:inset(0 100% 0 0 round 999px);transition:clip-path .55s cubic-bezier(.7,0,.2,1)}
.fc-btn:hover .fc-cap::before,.fc-btn:focus-visible .fc-cap::before{clip-path:inset(0 0 0 0 round 999px)}
.fc-btn:hover,.fc-btn:focus-visible{color:var(--fg2)}
.fc-btn.fc-noarr .fc-cap{padding-right:24px}
.fc-port{position:relative;width:9px;height:9px;flex:none;border-radius:50%;background:transparent;box-shadow:inset 0 0 0 2px currentColor;transition:background .3s,box-shadow .3s}
.fc-btn:hover .fc-port,.fc-btn:focus-visible .fc-port{background:var(--led);box-shadow:inset 0 0 0 2px var(--led),0 0 0 4px color-mix(in srgb,var(--led) 28%,transparent)}
.fc-arr{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;flex:none;background:var(--chip);color:var(--chipfg);transition:translate .5s cubic-bezier(.34,1.56,.64,1),rotate .5s cubic-bezier(.34,1.56,.64,1),background .3s,color .3s} .fc-btn:hover .fc-arr{rotate:-45deg}
.fc-lbl{position:relative;display:inline-block;height:1.2em;overflow:hidden;line-height:1.2} .fc-l1,.fc-l2{display:block;transition:translate .45s cubic-bezier(.7,0,.2,1)} .fc-btn:hover .fc-l1,.fc-btn:hover .fc-l2{translate:0 -100%}
.fc-btn.fc-solid{--face:var(--fc-ink);--edge:var(--fc-ink);--fill:var(--fc-brass);--fg:var(--fc-cloud);--fg2:var(--fc-ink);--led:var(--fc-ink);--chip:var(--fc-brass);--chipfg:var(--fc-ink)}
.fc-btn.fc-solid:hover{--chip:var(--fc-ink);--chipfg:var(--fc-brass)}
.fc-btn.fc-ghost{--face:transparent;--edge:color-mix(in srgb,var(--fc-ink) 22%,transparent);--fill:var(--fc-cloud);--fg:var(--fc-ink);--fg2:var(--fc-ink);--led:var(--fc-brass);--chip:var(--fc-ink);--chipfg:var(--fc-cloud)}
.fc-btn.fc-quiet{--face:color-mix(in srgb,var(--fc-cloud) 12%,transparent);--edge:color-mix(in srgb,var(--fc-cloud) 22%,transparent);--fill:var(--fc-brass);--fg:var(--fc-cloud);--fg2:var(--fc-ink);--led:var(--fc-ink);--chip:var(--fc-brass);--chipfg:var(--fc-ink)}
@media (max-width:600px),(hover:none){.fc .fc-btn{white-space:normal;text-align:left;line-height:1.25;min-height:52px;max-width:100%} .fc .fc-lbl{height:auto} .fc .fc-l2{display:none}}
.fc-btn:hover{transform:translate(var(--mx,0px),var(--my,0px))} .fc-btn:active{transform:translate(var(--mx,0px),var(--my,0px)) scale(.97)!important}
.fc-dark .fc-btn.fc-ghost{--face:color-mix(in srgb,var(--fc-cloud) 12%,transparent);--edge:color-mix(in srgb,var(--fc-cloud) 30%,transparent);--fill:var(--fc-cloud);--fg:var(--fc-cloud);--fg2:var(--fc-ink);--chip:var(--fc-cloud);--chipfg:var(--fc-ink)} .fc-dark .fc-btn.fc-ghost .fc-cap{-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
.fc-dark .fc-btn.fc-solid{--face:var(--fc-cloud);--edge:var(--fc-cloud);--fill:var(--fc-brass);--fg:var(--fc-ink);--fg2:var(--fc-ink);--chip:var(--fc-ink);--chipfg:var(--fc-cloud)}
/* TEXT-SAFE accents: mint is a FILL (ink text on it), a wire or a port; small mint TEXT on light grounds uses the darker --fc-acc. On dark grounds the mint itself reads. */
.fc{--fc-acc:color-mix(in srgb,var(--fc-brass) 40%,var(--fc-ink));--fc-acc-lg:color-mix(in srgb,var(--fc-brass) 62%,var(--fc-ink));--fc-mut:color-mix(in srgb,var(--fc-stone) 85%,var(--fc-ink));--fc-acc-d:var(--fc-brass)}
.fc-lt,.fc .fc-lt{--fc-acc:color-mix(in srgb,var(--fc-brass) 40%,var(--fc-ink));--fc-acc-lg:color-mix(in srgb,var(--fc-brass) 62%,var(--fc-ink));--fc-mut:color-mix(in srgb,var(--fc-stone) 85%,var(--fc-ink))}
.fc-dark,.fc.fc-dark{--fc-acc:var(--fc-brass);--fc-acc-lg:var(--fc-brass);--fc-mut:color-mix(in srgb,var(--fc-stone) 45%,var(--fc-cloud))}
/* LED segment strip (status rows) */
.fc-bar{width:26px;height:10px;flex:none;display:inline-block;background:repeating-linear-gradient(90deg,currentColor 0 1px,transparent 1px 3px,currentColor 3px 5px,transparent 5px 6px,currentColor 6px 7px,transparent 7px 9px,currentColor 9px 10px,transparent 10px 12px)}
@media (prefers-reduced-motion:reduce){.fc *,.sth *{animation-duration:.01ms!important;transition-duration:.01ms!important}}
.fccs-next:focus-visible,.fcpo-next:focus-visible,.fcw-row a:focus-visible,.fco-band:focus-visible,.fco-mq a:focus-visible{outline-offset:-4px!important;box-shadow:none!important}`,we=({s:e=15})=>u(`svg`,{width:e,height:e,viewBox:`0 0 24 24`,fill:`none`,stroke:`currentColor`,strokeWidth:`2`,strokeLinecap:`round`,strokeLinejoin:`round`,"aria-hidden":!0,children:u(`path`,{d:`M5 12h14M13 5l7 7-7 7`})}),M.Boolean,M.Number,Te=(e,t=0,n=22)=>({opacity:+!!e,translate:e?`0 0`:`0 ${n}px`,transition:`opacity .9s ease ${t}ms, translate 1s cubic-bezier(.2,.8,.2,1) ${t}ms`}),Ee=`
.fc[data-kb] *,.fc[data-kb] *::before,.fc[data-kb] *::after{transition:none!important}
.fc-sec{position:relative;z-index:10;display:block;width:100%;--sp:.5;--pp:0}
.fc-rev{position:relative;width:100%;--rv:1} .fc-rev-in{position:relative} .fc-rev-sp{height:0}
.fc-rev.is-act{--rv:0;--t:min(var(--h),100vh);--t:min(var(--h),100svh);z-index:var(--layer,9);margin-top:calc(var(--t)*-1)}
.fc-rev.is-act>.fc-rev-in{position:sticky;top:calc(100vh - var(--t));top:calc(100svh - var(--t))} .fc-rev.is-act>.fc-rev-sp{height:var(--t)}
/* the lifting edge throws a shadow on the section beneath, and that section comes out of the dark as it is uncovered */
.fc-rev.is-act>.fc-rev-in::before{content:"";position:absolute;z-index:40;left:0;right:0;top:0;height:120px;translate:0 calc((1 - var(--rv))*var(--t));background:linear-gradient(180deg,rgba(0,0,0,.2),rgba(0,0,0,0));opacity:min(1,calc(var(--rv)*(1 - var(--rv))*9));pointer-events:none}
.fc-rev.is-act>.fc-rev-in::after{content:"";position:absolute;z-index:39;left:0;right:0;top:0;height:var(--t);background:#000;opacity:calc((1 - var(--rv))*.16);pointer-events:none}
.fc-wrap{--pad:56px;width:100%;max-width:calc(${z} + var(--pad)*2);margin:0 auto;padding-left:var(--pad);padding-right:var(--pad)}
.fc-eb{display:inline-flex;align-items:center;gap:10px;width:max-content;max-width:100%;margin:0;padding:7px 14px 7px 8px;border-radius:999px;background:var(--fc-cloud);color:var(--fc-ink);box-shadow:inset 0 0 0 1px var(--fc-fog)!important;font-size:12px;letter-spacing:.1em;text-transform:uppercase;line-height:1.2;opacity:0;translate:0 10px;transition:opacity .7s ease,translate .8s cubic-bezier(.2,.8,.2,1);box-shadow:inset 0 1px 0 color-mix(in srgb,#fff 12%,transparent)} .fc-eb.is-on{opacity:1;translate:0 0}
.fc-eb i{position:relative;width:18px;height:18px;display:block;flex:none;border-radius:50%;background:var(--fc-brass)} .fc-eb i::after{content:"";position:absolute;inset:5px;border-radius:50%;border:2px solid var(--fc-ink);border-right-color:transparent;animation:fcSpin 1.2s linear infinite} @keyframes fcSpin{to{rotate:360deg}} @keyframes fcLed{0%,100%{opacity:1}50%{opacity:.35}}
.fc-dark .fc-eb{background:color-mix(in srgb,var(--fc-cloud) 8%,transparent);color:var(--fc-cloud);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-cloud) 16%,transparent)!important}
.fc-hd{margin:0;letter-spacing:-.045em;text-wrap:balance} .fc-hd-l{display:block}
.fc-hd-w{display:inline-block;overflow:hidden;vertical-align:top;padding:0 .05em .17em;margin:0 -.05em -.17em;white-space:pre}
.fc-hd-i{position:relative;display:inline-block;translate:0 108%;transition:translate 1s cubic-bezier(.2,.75,.2,1)}
.fc-hd.is-on .fc-hd-i{translate:0 0}
.fc-hd-w.is-accw{overflow:visible;clip-path:inset(-.6em -.6em .02em -.2em)}
.fc-it{position:relative;padding-right:.36em;background:linear-gradient(100deg,var(--fc-brass) 10%,color-mix(in srgb,var(--fc-brass) 35%,var(--fc-cloud)) 90%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent} :where(.fc:not(.fc-dark)) .fc-it{background:linear-gradient(100deg,var(--fc-ink) 10%,color-mix(in srgb,var(--fc-brass) 55%,var(--fc-ink)) 90%);-webkit-background-clip:text;background-clip:text}
.fc-spark{position:absolute;right:-.02em;top:.02em;width:.34em;height:.34em;overflow:visible;fill:var(--fc-brass);scale:0;rotate:-90deg;transition:scale .7s cubic-bezier(.34,1.56,.64,1) var(--pd,0ms),rotate .9s cubic-bezier(.2,.8,.2,1) var(--pd,0ms)}
.fc-hd.is-on .fc-spark{scale:1;rotate:0deg;animation:fcTw 3.2s ease-in-out calc(var(--pd,0ms) + 900ms) infinite} @keyframes fcTw{0%,100%{opacity:1;scale:1}50%{opacity:.55;scale:.72}}
.fc-um{position:relative;overflow:hidden;transition:clip-path 1.35s cubic-bezier(.7,0,.2,1);background:color-mix(in srgb,var(--fc-stone) 22%,transparent)}
.fc-um img{position:absolute;left:0;top:-9%;width:100%;height:118%;display:block;object-fit:cover;scale:1.28;translate:0 calc((var(--sp,.5) - .5)*var(--par,1)*-7%);transition:scale 1.9s cubic-bezier(.16,.84,.24,1);user-select:none}
.fc-um.is-on img{scale:1}
/* diagonal cuts: the section hangs over its neighbour and is cut on a slope (clip-path, so the neighbour shows through) */
.fc-cut-t{margin-top:calc(var(--cut,7vw)*-1);clip-path:polygon(0 var(--cut,7vw),100% 0,100% 100%,0 100%);padding-top:var(--cut,7vw)}
.fc-cut-b{margin-bottom:calc(var(--cut,7vw)*-1);padding-bottom:var(--cut,7vw)}
.fc-cut-t.fc-cut-b{clip-path:polygon(0 var(--cut,7vw),100% 0,100% calc(100% - var(--cut,7vw)),0 100%)}
.fc-cut-b:not(.fc-cut-t){clip-path:polygon(0 0,100% 0,100% calc(100% - var(--cut,7vw)),0 100%)}
@media (max-width:1099px){.fc-wrap{--pad:32px}}
@media (max-width:699px){.fc-wrap{--pad:20px}}
:root{--g:56px}@media (max-width:1099px){:root{--g:32px}}@media (max-width:699px){:root{--g:20px}}
@media (prefers-reduced-motion:reduce){.fc-hd-i{translate:0 0!important} .fc-spark{scale:1!important;rotate:0deg!important;animation:none!important} .fc-um{clip-path:none!important} .fc-um img{scale:1!important;translate:0 0!important}}
`,De={site:[{slug:`site`,f1:`argus`,f2:"AI 自动化工作室",f3:"为团队打造日常使用的 AI 智能体与自动化流程，覆盖客服、销售运营和后台事务，数周即可上线。",f4:`hello@argus.ai`,f5:`+1 646 555 0187`,f6:"纽约",f7:`America/New_York`,f8:`/book`,f9:`X:https://x.com, LinkedIn:https://linkedin.com, YouTube:https://youtube.com`,f10:"第四季度项目预约中 · 剩余 3 个名额",f11:"美国纽约市西 21 街 54 号，邮编 10010",f12:"周一至周五 09:00–18:00（美国东部时间）",f13:`1-5 09:00-18:00`,n1:`1`}],work:[{slug:`northwind-dental`,f1:`Northwind Dental`,f2:"医疗健康",f3:"让预约量提升 38% 的语音智能体",f4:`+38%`,f5:"预约量",f6:"六家诊所共用一条永不漏接的电话线。智能体直接在诊所管理软件中预约、改约和确认就诊。",f7:"语音智能体",img:`https://framerusercontent.com/images/OPO7hpxO5fFgicqBiebGwosE.webp`,f8:"六家诊所共用一条电话线。下午五点后和午休时，三分之一的来电无人接听，每一通漏接都意味着一次流失的预约。",f9:"语音智能体使用诊所的沟通风格，在诊所管理软件中预约、改约和确认就诊；涉及医疗判断的问题一律转交护士。",f10:"+38%|预约量;0|非工作时间漏接来电;4.8/5|来电者评分;11 h|每周为前台节省的时间",f11:"患者听不出这是智能体，前台终于有时间照顾现场的人了。",f12:"Dr. Sarah Kim, 医疗总监",f13:`4 weeks`,f14:`Vapi, Twilio, Dentrix, HubSpot`,n1:`1`},{slug:`ledgerly`,f1:`Ledgerly`,f2:"财会",f3:"月末结账从 9 天缩短至 2 天",f4:`2 days`,f5:"月末结账",f6:"由智能体核对发票、收据和银行流水，异常情况由人工审批。",f7:"工作流自动化",img:`https://framerusercontent.com/images/xC399cfk7wneLE2CiZd0LCKY70.webp`,f8:"月末结账耗时九天：需要在三个工具之间，手工核对 2,000 张发票、收据和银行流水。",f9:"发票智能体读取每份单据，与采购订单和银行流水核对，在 Xero 中入账，仅将异常情况交给人工处理。",f10:"2 天|月末结账;1,900|每周发票量;97%|无需人工匹配;9 h|每周节省时间",f11:"他们找出了我们每周浪费的九个小时，并将这些工作自动化。",f12:"Marcus Webb, 财务负责人",f13:`5 weeks`,f14:`n8n, Xero, Google Drive, Slack`,n1:`2`},{slug:`oakline-home`,f1:`Oakline Home`,f2:"电子商务",f3:"每 10 张客服工单中有 7 张由 AI 解决",f4:`71%`,f5:"工单由 AI 解决",f6:"根据 Shopify 数据，数秒内回答订单、退货与配送变更问题。",f7:"客服智能体",img:`https://framerusercontent.com/images/A1LSpWqZartLRT6sPWVxN0Ijbo.webp`,f8:"订单、退货和配送变更咨询挤满客服系统，高峰时段需要六小时才能回复。",f9:"通过聊天和邮件提供服务的客服智能体，根据 Shopify 数据和配送政策回答问题、处理退货，并在升级人工时附上回复草稿。",f10:"71%|工单由 AI 解决;38 s|首次回复;+9 分|CSAT;3x|每人处理工单量",f11:"71% 的工单无需人工处理，客户满意度也提升了。",f12:"Priya Nair, 客户体验负责人",f13:`4 weeks`,f14:`Gorgias, Shopify, OpenAI, Slack`,n1:`3`},{slug:`vantage-legal`,f1:`Vantage Legal`,f2:"法律服务",f3:"数秒找到每一份判例",f4:`9 s`,f5:"平均搜索用时",f6:"覆盖 14 年案件资料的私有知识库，遵循访问权限，回答附带来源。",f7:"AI 知识库",img:`https://framerusercontent.com/images/hPOHK0EMfYfzD6Gkwr40RfxeeRk.webp`,f8:"14 年的案件资料分散在文件夹中，只有合伙人才知道如何检索。",f9:"遵循访问权限的私有知识库，用通俗语言回答，并引用具体文档和页码。",f10:"9 s|平均搜索用时;14 年|年案件资料已索引;100%|回答附带来源;6 h|每位律师每周节省时间",f11:"这是我们的律师每天早上最先打开的工具。",f12:"Helen Park, 管理合伙人",f13:`6 weeks`,f14:`Anthropic, Pinecone, SharePoint, Teams`,n1:`4`},{slug:`brightpath-realty`,f1:`Brightpath Realty`,f2:"房地产",f3:"全天候响应，40 秒回复客户线索",f4:`40 s`,f5:"客户线索首次回复用时",f6:"每一条房产平台咨询，都会在经纪人查看前得到回复、看房时段及一条 CRM 记录。",f7:"工作流自动化",img:`https://framerusercontent.com/images/t7VGq6b8rzt8deI2pJExlQ61qzM.webp`,f8:"房产平台的咨询要等数小时才得到回复，那时买家早已联系了另外三位经纪人。",f9:"线索智能体在一分钟内回复，识别买家需求、提供看房时段，并在人工查看前写入 CRM。",f10:"40 s|首次回复;+27%|看房预约量;100%|线索已录入 CRM;24/7|覆盖时段",f11:"高效、细致，并坦诚说明 AI 的能力边界。",f12:"Daniel Ortiz，首席运营官",f13:`3 weeks`,f14:`Make, HubSpot, Google Calendar, WhatsApp`,n1:`5`}]},Oe=`FcWorkList@cms1`,ke=(e,t=`img`)=>String(e&&e[t]||``).split(`?`)[0],Ae=`data:image/svg+xml;utf8,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%20400%20500'%20preserveAspectRatio%3D'xMidYMid%20slice'%3E%3Crect%20width%3D'400'%20height%3D'500'%20fill%3D'%23D3D8E2'%2F%3E%3Crect%20x%3D'120'%20y%3D'170'%20width%3D'160'%20height%3D'160'%20rx%3D'8'%20fill%3D'none'%20stroke%3D'%23AEB6C6'%20stroke-width%3D'1.5'%2F%3E%3Crect%20x%3D'100'%20y%3D'150'%20width%3D'200'%20height%3D'200'%20rx%3D'10'%20fill%3D'none'%20stroke%3D'%23C3CAD8'%20stroke-width%3D'1'%20stroke-dasharray%3D'2%206'%2F%3E%3C%2Fsvg%3E`,je=(e,t=`img`)=>ke(e,t)||Ae,Me=a===void 0?m:r,Ne=`
.fcwl{position:relative;background:var(--fc-bone);color:var(--fc-ink);padding:clamp(60px,7vw,110px) 0 clamp(90px,10vw,150px)}
.fcwl-bar{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:clamp(30px,4vw,56px);flex-wrap:wrap}
.fcwl-chips{display:flex;flex-wrap:wrap;gap:8px} .fcwl-chips button{display:inline-flex;align-items:center;gap:8px;padding:11px 16px;border:0;border-radius:999px;background:var(--fc-cloud);color:var(--fc-ink);font:inherit;font-size:12.5px;cursor:pointer;box-shadow:inset 0 0 0 1px var(--fc-fog);transition:background .3s,color .3s} .fcwl-chips button:hover{background:color-mix(in srgb,var(--fc-brass) 30%,var(--fc-cloud))} .fcwl-chips button.is-on{background:var(--fc-ink);color:var(--fc-cloud);box-shadow:none} .fcwl-chips em{font-style:normal;font-size:12px;opacity:.6}
.fcwl-count{margin:0;font-size:12px;letter-spacing:.08em;color:var(--fc-mut)}
.fcwl-empty{margin:60px 0;font-size:32px;letter-spacing:-.03em;color:var(--fc-mut)}
.fcwl-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(20px,2.4vw,36px) clamp(16px,2vw,28px);align-items:start}
.fcwl-card{display:flex;flex-direction:column;gap:18px;color:inherit;text-decoration:none} .fcwl-card:nth-child(even):not(.is-big){margin-top:clamp(40px,6vw,110px)} .fcwl-card.is-big{grid-column:1/-1}
.fcwl-ph{position:relative;display:block;aspect-ratio:4/3.2;border-radius:28px;overflow:hidden;background:var(--fc-fog);clip-path:inset(100% 0 0 0 round 28px);transition:clip-path 1.2s cubic-bezier(.7,0,.2,1) var(--d)} .fcwl-card.is-big .fcwl-ph{aspect-ratio:16/7} .fcwl-card.is-on .fcwl-ph{clip-path:inset(0 0 0 0 round 28px)}
.fcwl-ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;scale:1.15;filter:grayscale(.55);transition:scale 1.4s cubic-bezier(.2,.8,.2,1),filter .6s} .fcwl-card.is-on .fcwl-ph img{scale:1.02} .fcwl-card:hover .fcwl-ph img{scale:1.08;filter:grayscale(0)}
.fcwl-tag{position:absolute;left:16px;top:16px;padding:7px 12px;border-radius:999px;background:color-mix(in srgb,var(--fc-night) 60%,transparent);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);color:var(--fc-cloud);font-size:12px;letter-spacing:.08em;text-transform:uppercase}
.fcwl-res{position:absolute;right:16px;bottom:16px;display:flex;flex-direction:column;align-items:flex-end;gap:2px;padding:14px 18px;border-radius:20px;background:var(--fc-brass);color:var(--fc-ink);translate:0 20px;opacity:0;transition:translate .5s cubic-bezier(.2,.8,.2,1),opacity .4s} .fcwl-card:hover .fcwl-res,.fcwl-card:focus-visible .fcwl-res,.fcwl-card.is-big .fcwl-res{translate:0 0;opacity:1} .fcwl-res b{font-size:40px;font-weight:500;letter-spacing:-.05em;line-height:1} .fcwl-res em{font-style:normal;font-size:12px}
.fcwl-tx{display:flex;flex-direction:column;gap:8px} .fcwl-cl{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--fc-acc)} .fcwl-t{font-size:clamp(24px,2.2vw,36px);font-weight:500;letter-spacing:-.04em;line-height:1.05} .fcwl-card.is-big .fcwl-t{font-size:clamp(32px,3.4vw,56px);max-width:900px}
.fcwl-go{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--fc-mut);transition:color .3s,gap .3s} .fcwl-card:hover .fcwl-go{color:var(--fc-ink);gap:10px}
.fcwl.is-ph .fcwl-grid{grid-template-columns:1fr} .fcwl.is-ph .fcwl-card:nth-child(even):not(.is-big){margin-top:0} .fcwl.is-ph .fcwl-card.is-big .fcwl-ph{aspect-ratio:4/3.2} .fcwl.is-ph .fcwl-res{translate:0 0;opacity:1}
