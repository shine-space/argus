.fc[data-kb] *,.fc[data-kb] *::before,.fc[data-kb] *::after{transition:none!important}
.fc-sec{position:relative;z-index:10;display:block;width:100%;--sp:.5;--pp:0}
.fc-rev{position:relative;width:100%;--rv:1} .fc-rev-in{position:relative} .fc-rev-sp{height:0}
.fc-rev.is-act{--rv:0;--t:min(var(--h),100vh);--t:min(var(--h),100svh);z-index:var(--layer,9);margin-top:calc(var(--t)*-1)}
.fc-rev.is-act>.fc-rev-in{position:sticky;top:calc(100vh - var(--t));top:calc(100svh - var(--t))} .fc-rev.is-act>.fc-rev-sp{height:var(--t)}
/* the lifting edge throws a shadow on the section beneath, and that section comes out of the dark as it is uncovered */
.fc-rev.is-act>.fc-rev-in::before{content:"";position:absolute;z-index:40;left:0;right:0;top:0;height:120px;translate:0 calc((1 - var(--rv))*var(--t));background:linear-gradient(180deg,rgba(0,0,0,.2),rgba(0,0,0,0));opacity:min(1,calc(var(--rv)*(1 - var(--rv))*9));pointer-events:none}
.fc-rev.is-act>.fc-rev-in::after{content:"";position:absolute;z-index:39;left:0;right:0;top:0;height:var(--t);background:#000;opacity:calc((1 - var(--rv))*.16);pointer-events:none}
.fc-wrap{--pad:56px;width:100%;max-width:calc(${Ce} + var(--pad)*2);margin:0 auto;padding-left:var(--pad);padding-right:var(--pad)}
.fc-eb{display:inline-flex;align-items:center;gap:10px;width:max-content;max-width:100%;margin:0;padding:7px 14px 7px 8px;border-radius:999px;background:var(--fc-cloud);color:var(--fc-ink);box-shadow:inset 0 0 0 1px var(--fc-fog)!important;font-size:12px;letter-spacing:.1em;text-transform:uppercase;line-height:1.2;opacity:0;translate:0 10px;transition:opacity .7s ease,translate .8s cubic-bezier(.2,.8,.2,1);box-shadow:inset 0 1px 0 color-mix(in srgb,#fff 12%,transparent)} .fc-eb.is-on{opacity:1;translate:0 0}
.fc-eb i{position:relative;width:18px;height:18px;display:block;flex:none;border-radius:50%;background:var(--fc-brass)} .fc-eb i::after{content:"";position:absolute;inset:5px;border-radius:50%;border:2px solid var(--fc-ink);border-right-color:transparent;animation:fcSpin 1.2s linear infinite} @keyframes fcSpin{to{rotate:360deg}} @keyframes fcLed{0%,100%{opacity:1}50%{opacity:.35}}
.fc-dark .fc-eb{background:color-mix(in srgb,var(--fc-cloud) 8%,transparent);color:var(--fc-cloud);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--fc-cloud) 16%,transparent)!important}
.fc-hd{margin:0;letter-spacing:-.045em;text-wrap:balance} .fc-hd-l{display:block}
.fc-hd-w{display:inline-block;overflow:hidden;vertical-align:top;padding:0 .05em .17em;margin:0 -.05em -.17em;white-space:pre}
.fc-hd-i{position:relative;display:inline-block;translate:0 108%;transition:translate 1s cubic-bezier(.2,.75,.2,1)}
.fc-hd.is-on .fc-hd-i{translate:0 0}
.fc-hd-w.is-accw{overflow:visible;clip-path:inset(-.6em -.6em .02em -.2em)}
.fc-it{position:relative;padding-right:.36em;background:linear-gradient(100deg,var(--fc-brass) 10%,color-mix(in srgb,var(--fc-brass) 35%,var(--fc-cloud)) 90%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent} :where(.fc:not(.fc-dark)) .fc-it{background:linear-gradient(100deg,var(--fc-ink) 10%,color-mix(in srgb,var(--fc-brass) 55%,var(--fc-ink)) 90%);-webkit-background-clip:text;background-clip:text}
.fc-spark{position:absolute;right:-.02em;top:.02em;width:.34em;height:.34em;overflow:visible;fill:var(--fc-brass);scale:0;rotate:-90deg;transition:scale .7s cubic-bezier(.34,1.56,.64,1) var(--pd,0ms),rotate .9s cubic-bezier(.2,.8,.2,1) var(--pd,0ms)}
.fc-hd.is-on .fc-spark{scale:1;rotate:0deg;animation:fcTw 3.2s ease-in-out calc(var(--pd,0ms) + 900ms) infinite} @keyframes fcTw{0%,100%{opacity:1;scale:1}50%{opacity:.55;scale:.72}}
.fc-um{position:relative;overflow:hidden;transition:clip-path 1.35s cubic-bezier(.7,0,.2,1);background:color-mix(in srgb,var(--fc-stone) 22%,transparent)}
.fc-um img{position:absolute;left:0;top:-9%;width:100%;height:118%;display:block;object-fit:cover;scale:1.28;translate:0 calc((var(--sp,.5) - .5)*var(--par,1)*-7%);transition:scale 1.9s cubic-bezier(.16,.84,.24,1);user-select:none}
.fc-um.is-on img{scale:1}
/* diagonal cuts: the section hangs over its neighbour and is cut on a slope (clip-path, so the neighbour shows through) */
.fc-cut-t{margin-top:calc(var(--cut,7vw)*-1);clip-path:polygon(0 var(--cut,7vw),100% 0,100% 100%,0 100%);padding-top:var(--cut,7vw)}
.fc-cut-b{margin-bottom:calc(var(--cut,7vw)*-1);padding-bottom:var(--cut,7vw)}
.fc-cut-t.fc-cut-b{clip-path:polygon(0 var(--cut,7vw),100% 0,100% calc(100% - var(--cut,7vw)),0 100%)}
.fc-cut-b:not(.fc-cut-t){clip-path:polygon(0 0,100% 0,100% calc(100% - var(--cut,7vw)),0 100%)}
@media (max-width:1099px){.fc-wrap{--pad:32px}}
@media (max-width:699px){.fc-wrap{--pad:20px}}
:root{--g:56px}@media (max-width:1099px){:root{--g:32px}}@media (max-width:699px){:root{--g:20px}}
@media (prefers-reduced-motion:reduce){.fc-hd-i{translate:0 0!important} .fc-spark{scale:1!important;rotate:0deg!important;animation:none!important} .fc-um{clip-path:none!important} .fc-um img{scale:1!important;translate:0 0!important}}
`,ze=({text:e,D:t,className:n=``})=>{let r=String(e||``).split(/\n+/).map(e=>e.trim()).filter(Boolean),i=[],a=[],o=()=>{a.length&&(i.push(f(`ul`,{children:a.map((e,t)=>f(`li`,{children:e},t))},`u`+i.length)),a=[])};return r.forEach(e=>{if(e.startsWith(`- `)){a.push(e.slice(2));return}o(),e.startsWith(`## `)?i.push(f(`h2`,{style:t,children:e.slice(3)},i.length)):e.startsWith(`> `)?i.push(f(`blockquote`,{style:t,children:e.slice(2)},i.length)):i.push(f(`p`,{children:e},i.length))}),o(),f(`div`,{className:`fc-md ${n}`,children:i})},Be=`
.fc-md{font-size:18px;line-height:1.7;color:color-mix(in srgb,var(--fc-ink) 86%,transparent)} .fc-md h2{margin:1.8em 0 .5em;font-size:clamp(26px,2.4vw,34px);font-weight:700;letter-spacing:-.035em;line-height:1.15;color:var(--fc-ink)} .fc-md h2:first-child{margin-top:0} .fc-md p{margin:0 0 1em}
.fc-md ul{list-style:none;margin:0 0 1.2em;padding:0;display:flex;flex-direction:column;gap:10px} .fc-md li{position:relative;padding-left:24px} .fc-md li::before{content:"";position:absolute;left:0;top:.62em;width:9px;height:9px;border-radius:2px;background:var(--fc-brass);box-shadow:0 0 6px color-mix(in srgb,var(--fc-brass) 60%,transparent)}
.fc-md blockquote{margin:1.4em 0;padding:22px 26px;border-radius:16px;background:var(--fc-ink);color:var(--fc-cloud);font-size:clamp(20px,1.8vw,26px);line-height:1.35;letter-spacing:-.02em;font-weight:600;position:relative} .fc-md blockquote::before{content:"";position:absolute;left:26px;top:-6px;width:40px;height:12px;border-radius:3px;background:var(--fc-brass)}`,J={site:[{slug:`site`,f1:`argus`,f2:"AI 自动化工作室",f3:"为团队打造日常使用的 AI 智能体与自动化流程，覆盖客服、销售运营和后台事务，数周即可上线。",f4:`hello@argus.ai`,f5:`+1 646 555 0187`,f6:"纽约",f7:`America/New_York`,f8:`/book`,f9:`X:https://x.com, LinkedIn:https://linkedin.com, YouTube:https://youtube.com`,f10:"第四季度项目预约中 · 剩余 3 个名额",f11:"美国纽约市西 21 街 54 号，邮编 10010",f12:"周一至周五 09:00–18:00（美国东部时间）",f13:`1-5 09:00-18:00`,n1:`1`}],posts:[{slug:`where-to-start-with-ai-automation`,f1:"AI 自动化从哪里开始（不是聊天机器人）",f2:"指南",f3:`7 min`,f4:"最值得先构建的智能体，几乎从来不是你网站首页上的聊天机器人。这里介绍我们如何在评估中作出选择。",f5:"## 从最耗时的工作开始 大多数团队首先想要一个聊天机器人。但真正耗时的工作往往不那么显眼：在工具间复制数据、催促回复、核对文档。 ## 我们会问三个问题 - 这项任务多久发生一次？ - 人工处理一次需要几分钟？ - 出错后会有什么影响？ 将前两项相乘，再评估第三项。排在最前面的，就是值得优先自动化的工作。 ## 保留人工参与 任何智能体的初版都应将复杂情况连同处理草稿交给人工。信任来自日志，而非演示。",f6:`Nadia Rahman`,f7:"2026 年 9 月 12 日",img:`https://framerusercontent.com/images/VDw9kSAfKcII06HWmBCzlXra2w.webp`,n1:`1`},{slug:`voice-agents-for-clinics`,f1:"语音智能体为六家牙科诊所带来了什么改变",f2:"案例手记",f3:`5 min`,f4:"非工作时间零漏接，预约量提升 38%，前台终于能抬头照顾现场的人。",f5:"## 问题出在电话 午休和下午五点后，三分之一的来电无人接听。 ## 我们做了什么 语音智能体使用诊所的沟通风格，直接在诊所管理软件中预约、改约和确认就诊。 ## 带来的改变 两个月内，预约量增长 38%，前台每周节省了 11 小时。",f6:`Kofi Mensah`,f7:"2026 年 8 月 28 日",img:`https://framerusercontent.com/images/4Qy54YZKQfoqydh1duQiAZSMhBo.webp`,n1:`2`},{slug:`agents-need-guardrails`,f1:"智能体需要约束机制，而不只是提示词",f2:"观点",f3:`6 min`,f4:"人工接管规则、日志和每周复盘，才是让智能体放心独立运行的保障。",f5:"## 提示词不等于规则 好的提示词能做好演示，完善的约束机制才能保障日常运行。 ## 我们为每个智能体配置什么 - 明确的人工接管条件 - 每一步操作的完整日志 - 上线首月的每周复盘 ## 最终结果 让人充分信任、无需反复检查的智能体。",f6:`Nadia Rahman`,f7:"2026 年 8 月 9 日",img:`https://framerusercontent.com/images/24R6jbtpYqHNUCW6JkLpsEM4xr0.webp`,n1:`3`}],team:[{slug:`nadia-rahman`,f1:`Nadia Rahman`,f2:"自动化负责人",f3:"曾在两家快速成长的企业负责运营，之后开始打造自己当年期待拥有的智能体。",img:`https://framerusercontent.com/images/msSr3aFiYWr5AeW5HFJveqW8Ikw.webp`,n1:`1`},{slug:`kofi-mensah`,f1:`Kofi Mensah`,f2:"AI 首席工程师",f3:"开发语音和工作流智能体，重视日志与人工接管规则。",img:`https://framerusercontent.com/images/KlxBQZf0VdDz9LZ380WbtBGW4.webp`,n1:`2`},{slug:`ingrid-solberg`,f1:`Ingrid Solberg`,f2:"解决方案设计师",f3:"与客户梳理流程，并转化为智能体规格说明。",img:`https://framerusercontent.com/images/EafIAfdeuX4HicNn6hoUEhhCOs.webp`,n1:`3`},{slug:`mateo-alvarez`,f1:`Mateo Alvarez`,f2:"系统集成工程师",f3:"将智能体接入 CRM、客服和财务工具，确保现有系统平稳运行。",img:`https://framerusercontent.com/images/ofk1TJhVoioTNZgTMDue4RB7sQQ.webp`,n1:`4`}]},Ve=`FcPost@cms1`,He=(e,t=`img`)=>String(e&&e[t]||``).split(`?`)[0],Ue=`data:image/svg+xml;utf8,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%20400%20500'%20preserveAspectRatio%3D'xMidYMid%20slice'%3E%3Crect%20width%3D'400'%20height%3D'500'%20fill%3D'%23D3D8E2'%2F%3E%3Crect%20x%3D'120'%20y%3D'170'%20width%3D'160'%20height%3D'160'%20rx%3D'8'%20fill%3D'none'%20stroke%3D'%23AEB6C6'%20stroke-width%3D'1.5'%2F%3E%3Crect%20x%3D'100'%20y%3D'150'%20width%3D'200'%20height%3D'200'%20rx%3D'10'%20fill%3D'none'%20stroke%3D'%23C3CAD8'%20stroke-width%3D'1'%20stroke-dasharray%3D'2%206'%2F%3E%3C%2Fsvg%3E`,Y=(e,t=`img`)=>He(e,t)||Ue,We=o===void 0?g:r,X=`
.fcpo{position:relative;background:var(--fc-bone);color:var(--fc-ink);padding:clamp(140px,16vh,190px) 0 clamp(90px,10vw,150px)}
.fcpo-prog{position:fixed;left:0;right:0;top:0;z-index:1200;height:3px;pointer-events:none} .fcpo-prog span{display:block;height:100%;background:var(--fc-brass);transform:scaleX(0);transform-origin:0 50%;box-shadow:0 0 12px var(--fc-brass)}
.fcpo-cr ol{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:0 0 24px;padding:0;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--fc-mut)} .fcpo-cr li+li::before{content:"/";margin-right:8px;opacity:.5} .fcpo-cr a{color:inherit;text-decoration:none}
.fcpo-meta{display:flex;align-items:center;gap:10px;margin:0 0 20px;font-size:12px;color:var(--fc-mut)} .fcpo-meta em{font-style:normal;padding:5px 10px;border-radius:999px;background:var(--fc-brass);color:var(--fc-ink);font-size:12px;letter-spacing:.08em;text-transform:uppercase}
.fcpo-sum{margin:24px 0 0;max-width:720px;font-size:clamp(18px,1.4vw,22px);line-height:1.5;color:var(--fc-mut)}
.fcpo-cover{position:relative;aspect-ratio:21/9;margin:clamp(40px,5vw,70px) 0;border-radius:32px;overflow:hidden;background:var(--fc-fog);clip-path:inset(0 30% 0 30% round 32px);transition:clip-path 1.5s cubic-bezier(.7,0,.2,1) .3s} .fcpo.is-in .fcpo-cover{clip-path:inset(0 0 0 0 round 32px)}
.fcpo-cover img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;scale:1.15;transition:scale 2s cubic-bezier(.16,.84,.24,1) .3s} .fcpo.is-in .fcpo-cover img{scale:1}
.fcpo-grid{display:grid;grid-template-columns:minmax(0,720px) 300px;justify-content:space-between;gap:60px;align-items:start}
.fcpo-side{position:sticky;top:110px} .fcpo-card{display:flex;flex-direction:column;gap:12px;padding:22px;border-radius:24px;background:var(--fc-cloud);box-shadow:inset 0 0 0 1px var(--fc-fog)} .fcpo-card>p{margin:6px 0 0;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--fc-mut)}
.fcpo-au{display:flex;align-items:center;gap:12px} .fcpo-au img{width:52px;height:52px;border-radius:50%;object-fit:cover} .fcpo-au span{display:flex;flex-direction:column;gap:2px} .fcpo-au b{font-size:17px;font-weight:600} .fcpo-au em{font-style:normal;font-size:12px;color:var(--fc-acc)}
.fcpo-share{display:flex;flex-wrap:wrap;gap:6px} .fcpo-share a,.fcpo-share button{padding:9px 13px;border:0;border-radius:999px;background:var(--fc-bone);color:var(--fc-ink);font:inherit;font-size:12px;text-decoration:none;cursor:pointer;transition:background .3s} .fcpo-share a:hover,.fcpo-share button:hover{background:var(--fc-brass)}
.fcpo-next{display:flex;flex-direction:column;gap:12px;margin-top:clamp(70px,8vw,120px);padding-top:40px;border-top:1px solid var(--fc-fog);color:inherit;text-decoration:none} .fcpo-next span{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--fc-acc)} .fcpo-next b{max-width:900px;font-size:clamp(32px,3.6vw,64px);font-weight:500;letter-spacing:-.045em;line-height:1.02} .fcpo-next i{display:grid;place-items:center;width:56px;height:56px;border-radius:50%;background:var(--fc-ink);color:var(--fc-brass);transition:rotate .5s} .fcpo-next:hover i{rotate:-45deg}
